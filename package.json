{
  "name": "timrios-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "format": "prettier --write src scripts \"*.{ts,mjs,json}\"",
    "check": "npm run format:check && npm run typecheck && npm run build",
    "shots": "node $HOME/Tools/site-checks/shots.mjs",
    "phone-check": "node $HOME/Tools/site-checks/phone-check.mjs",
    "client-shots": "node $HOME/Tools/site-checks/client-shots.mjs",
    "project-screens": "node scripts/project-screens.mjs",
    "resume-pdf": "node --env-file-if-exists=.env scripts/resume-pdf.mjs",
    "format:check": "prettier --check src scripts \"*.{ts,mjs,json}\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
