# Basic browser protections on every page. HSTS isn't here: Cloudflare sends it for the whole domain, set in the
# private dns-live Terraform repo (one year, no includeSubDomains, since the mail records live beside the site).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Built assets (CSS, JS, images, fonts) have content-hashed names, so browsers can keep them for good
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The workers.dev copy stays out of search so timrios.dev is the only indexed address
https://timrios.myrrh-billion-34.workers.dev/*
  X-Robots-Tag: noindex
