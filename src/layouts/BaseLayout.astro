---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WindowLight from "../components/WindowLight.astro";
import Dock from "../components/Dock.astro";
import { site } from "../data/site";
import { imageUrl } from "../utils/images";
import "../styles/global.css";

interface Props {
  /** Page title; " | Tim Rios" is added, except on the home page, which passes the full title */
  title: string;
  description: string;
  /** Social preview image, a path in src/assets/images/ */
  image: string;
  /** Keep a page out of search results (thank-you, 404) */
  noindex?: boolean;
  /** The home page's title is already complete */
  fullTitle?: boolean;
}

const { title, description, image, noindex = false, fullTitle = false } = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// JPEG, because not every link-preview app reads WebP
const ogImage = new URL(await imageUrl(image, 1200, "jpg"), Astro.site);
// Tim is a service-area business with no storefront, so the business has no street address, only the city it serves
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${Astro.site?.href}#tim`,
      name: site.name,
      url: Astro.site?.href,
      email: `mailto:${site.email}`,
      jobTitle: "Website and brand designer",
      address: {
        "@type": "PostalAddress",
        addressLocality: site.city,
        addressRegion: site.region,
        addressCountry: "US",
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${Astro.site?.href}#business`,
      name: site.name,
      url: Astro.site?.href,
      description: site.description,
      email: site.email,
      telephone: site.phoneSms,
      founder: { "@id": `${Astro.site?.href}#tim` },
      areaServed: { "@type": "City", name: site.city },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Inline, not in global.css: Chromium drops the page transition on most clicks when this rule is in a stylesheet
         the browser has to revalidate, so it must not depend on a stylesheet's cache state. Safari doesn't mind. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <!-- Before anything paints: the visitor's saved look, else dark (DESIGN.md → Color) -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        root.dataset.theme = saved === "light" ? "light" : "dark";
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123a2c" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-mona-sans" preload />
    <Font cssVariable="--font-dm-mono" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <svg class="visually-hidden" aria-hidden="true" focusable="false">
      <symbol id="star" viewBox="-200 -200 400 400">
        <path
          fill="currentColor"
          d="M21 -157.3Q29.9 -169.4 34.1 -155L59.8 -66.9Q61.9 -59.7 69 -57.4L156.1 -28.6Q170.3 -23.9 157.9 -15.5L82.1 36.2Q75.9 40.4 75.9 47.9L75.5 139.6Q75.4 154.6 63.5 145.4L-9 89.3Q-14.9 84.7 -22.1 87L-109.4 114.9Q-123.7 119.5 -118.7 105.4L-87.7 19Q-85.2 12 -89.5 5.9L-143.1 -68.6Q-151.9 -80.7 -136.9 -80.3L-45.2 -77.5Q-37.7 -77.3 -33.3 -83.3Z"
        ></path>
      </symbol>
    </svg>
    <WindowLight />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Dock />
  </body>
</html>
