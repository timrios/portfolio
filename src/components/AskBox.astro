---
// The opening asks the owner what's wrong. The field types the real problems once by itself and rests on the first, and
// stops as soon as the visitor focuses it. Whatever they write goes to the contact form, prefilled.
import { site } from "../data/site";

const { ask } = site.home;
---

<form
  class="ask"
  action="/contact/"
  method="get"
  data-ask
  data-examples={JSON.stringify(ask.examples)}
>
  <label for="ask-need">{ask.label}</label>
  <div class="box">
    <input id="ask-need" name="need" type="text" autocomplete="off" placeholder={ask.examples[0]} />
    <button class="btn btn--primary" type="submit">
      {ask.submit}
    </button>
  </div>
</form>

<style>
  label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--text-ui);
    font-weight: 620;
  }

  .box {
    display: flex;
    flex-direction: column;
    padding: var(--space-1);
    border-radius: var(--radius-plate);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--field-border),
      0 10px 20px -14px color-mix(in oklch, var(--shadow-tint) 50%, transparent);
    transition: box-shadow var(--t-fast) var(--ease);
  }

  .box:focus-within {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  input {
    width: 100%;
    min-width: 0;
    min-height: 2.875rem;
    padding-inline: var(--space-3);
    border: 0;
    border-radius: var(--radius-inner);
    background: none;
    color: var(--text);
    font: 400 var(--text-ui) / 1.3 var(--font-body);
    text-overflow: ellipsis;
  }

  input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  /* The box itself shows focus */
  input:focus-visible {
    outline: none;
  }

  .btn {
    min-height: 3rem;
    border-radius: var(--radius-inner);
    white-space: nowrap;
  }

  /* Wide enough for field and button on one line, with the whole example showing */
  @media (min-width: 1431px) {
    .box {
      flex-direction: row;
      align-items: center;
      gap: var(--space-1);
    }

    input {
      flex: 1;
      min-height: var(--target);
      padding-inline: var(--space-3) 0;
      font-size: var(--text-small);
    }

    .btn {
      min-height: var(--target);
      padding-inline: var(--space-4);
      font-size: var(--text-small);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-ask]");
  const input = form?.querySelector("input");
  if (form && input && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const examples: string[] = JSON.parse(form.dataset.examples!);
    let index = 0;
    let length = examples[0].length;
    let deleting = true;
    let stopped = false;

    const tick = () => {
      if (stopped) return;
      length += deleting ? -1 : 1;
      input.placeholder = examples[index].slice(0, length);
      if (deleting && length === 0) {
        deleting = false;
        index = (index + 1) % examples.length;
        setTimeout(tick, 300);
      } else if (!deleting && length === examples[index].length) {
        // Back to the first example: the tour is over and it rests here
        if (index === 0) return;
        deleting = true;
        setTimeout(tick, 2000);
      } else {
        setTimeout(tick, deleting ? 22 : 45);
      }
    };
    setTimeout(tick, 2500);

    input.addEventListener("focus", () => {
      stopped = true;
      input.placeholder = examples[0];
    });
  }
</script>
