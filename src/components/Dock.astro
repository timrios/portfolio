---
// Phones: what you act on sits under the thumb. Menu and Text me are always here; Free quote joins once the question box
// has scrolled away. The dock steps aside for the keyboard and for the closing band. Menu opens a native dialog sheet.
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";
---

<div class="only-phone">
  <nav class="dock" aria-label={site.dock.label} data-dock>
    <button class="menu" type="button" aria-haspopup="dialog" data-menu-open>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 8h16M4 16h16"></path>
      </svg>
      {site.dock.menu}
    </button>
    <a class="quote" href={site.home.primaryAction.href}>
      {site.dock.quote}
    </a>
    <a class="text" href={`sms:${site.phoneSms}`}>
      {site.home.textAction}
    </a>
  </nav>

  <dialog class="sheet" aria-label={site.dock.menu} data-menu>
    <button class="close" type="button" data-menu-close>
      {site.dock.close}
    </button>
    <a href="/">{site.dock.home}</a>
    {site.navigation.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <ThemeToggle labeled />
  </dialog>
</div>

<style>
  .dock {
    position: fixed;
    z-index: 40;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(var(--space-2) + env(safe-area-inset-bottom));
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border-radius: var(--radius-plate);
    background: var(--plate);
    color: var(--on-plate);
    box-shadow:
      0 0 0 1px var(--rule),
      0 14px 28px -12px color-mix(in oklch, var(--shadow-tint) 70%, transparent);
    transition: translate var(--t-base) var(--ease);
  }

  .dock:global(.gone) {
    translate: 0 calc(100% + var(--space-6));
  }

  .dock > * {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.125rem;
    border-radius: var(--radius-inner);
    color: inherit;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu {
    gap: var(--space-2);
    margin-right: auto;
    padding-inline: var(--space-3);
  }

  .menu svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .quote {
    overflow: hidden;
    max-width: 0;
    padding-inline: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      max-width var(--t-base) var(--ease),
      padding var(--t-base) var(--ease),
      opacity var(--t-base) var(--ease);
  }

  .dock:global(.past) .quote {
    max-width: 9rem;
    padding-inline: var(--space-3);
    opacity: 1;
    visibility: visible;
    box-shadow: inset 0 0 0 1px var(--color-edge-oak);
  }

  .dock .text {
    padding-inline: var(--space-4);
    background: var(--marigold);
    color: var(--on-marigold);
  }

  .dock :focus-visible,
  .sheet :focus-visible {
    outline-color: var(--color-marigold);
  }

  .sheet {
    margin: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: none;
    border: 0;
    padding: var(--space-4) var(--gutter) calc(var(--space-6) + env(safe-area-inset-bottom));
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--plate);
    color: var(--on-plate);
  }

  .sheet::backdrop {
    background: color-mix(in oklch, var(--color-night) 45%, transparent);
  }

  .sheet > a {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    color: inherit;
    font-size: var(--text-3);
    font-weight: 540;
    letter-spacing: -0.015em;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-paper) 14%, transparent);
  }

  .close {
    display: flex;
    align-items: center;
    min-height: var(--target);
    margin-left: auto;
    padding-inline: var(--space-3);
    font-weight: 500;
  }

  /* A resume printed from this site must not carry the menu */
  @media print {
    .dock {
      display: none;
    }
  }
</style>

<script>
  const dock = document.querySelector<HTMLElement>("[data-dock]");
  const sheet = document.querySelector<HTMLDialogElement>("[data-menu]");
  if (dock && sheet) {
    // "Free quote" joins once the question box is gone; pages without one (except Contact itself) show it from the start
    const ask = document.querySelector("[data-ask]");
    if (ask) {
      new IntersectionObserver(([entry]) => {
        dock.classList.toggle("past", !entry.isIntersecting && entry.boundingClientRect.top < 0);
      }).observe(ask);
    } else if (!location.pathname.startsWith("/contact")) {
      dock.classList.add("past");
    }

    // Steps aside for the closing band, which has the same actions, and for the keyboard
    const closing = document.querySelector("[data-closing]");
    let atClosing = false;
    let typing = false;
    const update = () => dock.classList.toggle("gone", atClosing || typing);
    if (closing) {
      new IntersectionObserver(
        ([entry]) => {
          atClosing = entry.isIntersecting;
          update();
        },
        { threshold: 0.4 },
      ).observe(closing);
    }
    const isField = (target: EventTarget | null) =>
      target instanceof HTMLElement && target.matches("input:not([type=checkbox]), textarea");
    addEventListener("focusin", (event) => {
      typing = isField(event.target);
      update();
    });
    addEventListener("focusout", (event) => {
      if (isField(event.target)) typing = false;
      update();
    });

    document.querySelector("[data-menu-open]")?.addEventListener("click", () => sheet.showModal());
    document.querySelector("[data-menu-close]")?.addEventListener("click", () => sheet.close());
    // A press on the backdrop lands on the dialog itself; a link closes it, for links within this page
    sheet.addEventListener("click", (event) => {
      if (event.target === sheet || (event.target as HTMLElement).closest("a")) sheet.close();
    });
  }
</script>
