---
// The site's ambient life: a band of stars that winds down the whole page like the Milky Way, with empty sky on either
// side (DESIGN.md → Interaction). Two depths, so it feels like a real space: a far layer that's dim and slow, and a near
// layer that's brighter and sparser and moves faster, both as it drifts and as the page scrolls. Near stars sometimes
// carry a client's color. Stars live in page space along the band's path, so the band passes behind sections as
// the visitor scrolls instead of filling the whole screen.
import { projects } from "../data/projects";

const clientColors = projects.map((project) => project.accent);
---

<canvas
  class="star-band"
  aria-hidden="true"
  data-star-band
  data-clients={JSON.stringify(clientColors)}
></canvas>

<style>
  .star-band {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media print {
    .star-band {
      display: none;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-star-band]");
  const ctx = canvas?.getContext("2d");

  type Star = {
    t: number; // Position along the band, 0 to 1 of its length
    off: number; // Distance from the band's center, in band widths
    speed: number; // Drift along the band, in pixels per second
    size: number;
    alpha: number;
    phase: number; // Twinkle and wobble timing
    rate: number;
    color: string | null; // A client's color, or null for the look's own star color
  };
  type Layer = { depth: number; stars: Star[] };

  if (canvas && ctx) {
    const root = document.documentElement;
    const clients: string[] = JSON.parse(canvas.dataset.clients!);
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(pointer: fine)").matches;
    const small = innerWidth < 768;

    // Roughly bell-shaped, so stars crowd the band's center and thin out at its edges
    const gauss = () => Math.random() + Math.random() + Math.random() + Math.random() - 2;

    let colors = { star: "", far: "", haze: "", dark: true };
    const readColors = () => {
      const dark = root.dataset.theme !== "light";
      const css = getComputedStyle(root);
      colors = {
        dark,
        star: css.getPropertyValue(dark ? "--color-frost" : "--color-prussian").trim(),
        far: css.getPropertyValue(dark ? "--color-sky" : "--color-steel").trim(),
        haze: css.getPropertyValue(dark ? "--color-prussian" : "--color-sky").trim(),
      };
      hazeSprite = makeHaze(colors.haze);
    };

    // A soft cloud, drawn once and stamped for the haze in the band
    let hazeSprite: HTMLCanvasElement;
    const makeHaze = (color: string) => {
      const sprite = document.createElement("canvas");
      sprite.width = sprite.height = 256;
      const c = sprite.getContext("2d")!;
      const g = c.createRadialGradient(128, 128, 0, 128, 128, 128);
      g.addColorStop(0, color);
      g.addColorStop(1, "transparent");
      c.fillStyle = g;
      c.fillRect(0, 0, 256, 256);
      return sprite;
    };

    const pageHeight = () => Math.max(document.documentElement.scrollHeight, innerHeight);

    // Stars gather in clumps along the band, with gaps between: this is what keeps it from looking like a pattern
    const clumps = Array.from({ length: 26 }, () => ({
      t: Math.random(),
      weight: 0.4 + Math.random(),
    }));
    const alongBand = () => {
      if (Math.random() < 0.35) return Math.random();
      const clump = clumps[Math.floor(Math.random() * clumps.length)];
      return (clump.t + gauss() * 0.018 * clump.weight + 1) % 1;
    };

    const scale = small ? 0.4 : 1;
    const screens = pageHeight() / innerHeight;
    const makeLayer = (depth: number, perScreen: number, make: () => Partial<Star>): Layer => ({
      depth,
      stars: Array.from({ length: Math.round(perScreen * screens * scale) }, () => ({
        t: alongBand(),
        off: gauss(),
        speed: 4,
        size: 1,
        alpha: 0.5,
        phase: Math.random() * Math.PI * 2,
        rate: 0.4 + Math.random() * 1.2,
        color: null,
        ...make(),
      })),
    });

    const far = makeLayer(0.55, 760, () => ({
      speed: 3 + Math.random() * 5,
      size: 0.55 + Math.random() * 0.95,
      alpha: 0.35 + Math.random() * 0.55,
    }));
    const near = makeLayer(1.15, 60, () => ({
      speed: 10 + Math.random() * 28,
      size: 1.2 + Math.random() * 1.7,
      alpha: 0.55 + Math.random() * 0.45,
      off: gauss() * 1.35,
      color: Math.random() < 0.17 ? clients[Math.floor(Math.random() * clients.length)] : null,
    }));
    const hazes = Array.from({ length: Math.round(screens * 5) }, () => ({
      t: Math.random(),
      off: gauss() * 0.55,
      size: 260 + Math.random() * 420,
      alpha: 0.07 + Math.random() * 0.13,
    }));

    // The band's center at a point along it: swings across the page in a long, uneven S
    const bandX = (t: number, w: number) =>
      w * (0.56 + 0.34 * Math.sin(t * 9.4 + 0.5) + 0.1 * Math.sin(t * 23 + 2));

    let pointerX = 0;
    let pointerY = 0;
    let easedX = 0;
    let easedY = 0;
    if (fine && !still) {
      addEventListener("pointermove", (event) => {
        pointerX = event.clientX / innerWidth - 0.5;
        pointerY = event.clientY / innerHeight - 0.5;
      });
    }

    let last = performance.now();
    let width = 0;
    let height = 0;
    let bandWidth = 0;
    let page = 0;

    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.75);
      width = innerWidth;
      height = innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      bandWidth = Math.max(95, width * 0.11);
      page = pageHeight();
    };

    const drawLayer = (layer: Layer, dt: number, time: number) => {
      // A layer moving at a different speed from the page spans a different height, so it still fills the whole scroll
      const factor = still ? 1 : layer.depth;
      const span = (page - height) * factor + height + 200;
      const y0 = scrollY * factor;
      for (const star of layer.stars) {
        if (!still) star.t = (star.t + (star.speed * dt) / span) % 1;
        const y = star.t * span - y0 - 100 + easedY * 26 * layer.depth;
        if (y < -8 || y > height + 8) continue;
        const wobble = still ? 0 : Math.sin(time * 0.25 * star.rate + star.phase) * 7 * layer.depth;
        const x = bandX(star.t, width) + star.off * bandWidth + wobble + easedX * 26 * layer.depth;
        const twinkle = still ? 1 : 0.65 + 0.35 * Math.sin(time * star.rate + star.phase);
        ctx.globalAlpha = star.alpha * twinkle * (colors.dark ? 1 : 0.8);
        ctx.fillStyle = star.color ?? (layer === far ? colors.far : colors.star);
        ctx.beginPath();
        ctx.arc(x, y, star.size, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const draw = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      const time = now / 1000;
      easedX += (pointerX - easedX) * 0.04;
      easedY += (pointerY - easedY) * 0.04;
      ctx.clearRect(0, 0, width, height);

      // Haze first, on the far layer's depth, breathing very slowly
      const factor = still ? 1 : far.depth;
      const span = (page - height) * factor + height + 200;
      for (const cloud of hazes) {
        const y = cloud.t * span - scrollY * factor - 100;
        if (y < -cloud.size || y > height + cloud.size) continue;
        const x = bandX(cloud.t, width) + cloud.off * bandWidth;
        ctx.globalAlpha =
          cloud.alpha *
          (colors.dark ? 1.5 : 0.8) *
          (still ? 1 : 0.8 + 0.2 * Math.sin(time * 0.3 + cloud.t * 40));
        ctx.drawImage(hazeSprite, x - cloud.size / 2, y - cloud.size / 2, cloud.size, cloud.size);
      }

      drawLayer(far, dt, time);
      drawLayer(near, dt, time);
      ctx.globalAlpha = 1;
    };

    const loop = (now: number) => {
      if (!document.hidden) draw(now);
      requestAnimationFrame(loop);
    };

    readColors();
    size();
    addEventListener("resize", size);
    new ResizeObserver(() => {
      page = pageHeight();
      if (still) draw(performance.now());
    }).observe(document.body);
    new MutationObserver(() => {
      readColors();
      if (still) draw(performance.now());
    }).observe(root, { attributes: true, attributeFilter: ["data-theme"] });

    if (still) {
      addEventListener("scroll", () => draw(performance.now()), { passive: true });
      draw(performance.now());
    } else {
      requestAnimationFrame(loop);
    }
  }
</script>
