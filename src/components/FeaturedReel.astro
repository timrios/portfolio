---
// One Reel, emphasized: a large phone playing it, its story beside it, and stills to switch to the others. Only the
// chosen clip loads and plays, only while on screen; a button pauses it, and it starts paused under reduced motion.
import { reels, reelsSection } from "../data/reels";

interface Props {
  /** Show only this project's Reels, without the section heading (inside a project page) */
  projectId?: string;
}

const { projectId } = Astro.props;
const shown = projectId ? reels.filter((reel) => reel.projectId === projectId) : reels;
const first = shown[0];
---

{first && (
  <div
    class:list={["reel", { container: !projectId, section: !projectId, inline: projectId }]}
    data-reel-box
  >
    {!projectId && <h2 class="head">{reelsSection.heading}</h2>}
    <div class="phone">
      <video
        src={`/media/reels/${first.video}`}
        poster={`/media/reels/${first.poster}`}
        muted
        loop
        playsinline
        preload="none"
        aria-label={first.alt}
        data-reel
      />
    </div>
    <div class="words">
      <p class="title" data-reel-title>
        {first.title}
      </p>
      <p class="story" data-reel-story>
        {first.story}
      </p>
      <ul class="stills" role="list" aria-label={reelsSection.pickLabel}>
        {shown.map((reel, i) => (
          <li>
            <button
              type="button"
              aria-pressed={i === 0 ? "true" : "false"}
              data-reel-pick
              data-video={`/media/reels/${reel.video}`}
              data-poster={`/media/reels/${reel.poster}`}
              data-title={reel.title}
              data-story={reel.story}
              data-alt={reel.alt}
            >
              <img
                src={`/media/reels/${reel.poster}`}
                alt=""
                loading="lazy"
                width="432"
                height="768"
              />
              <span class="visually-hidden">{reel.title}</span>
              {reel.ai && <span class="tag">{reelsSection.aiLabel}</span>}
            </button>
          </li>
        ))}
      </ul>
      <div class="controls">
        <button
          type="button"
          class="pause"
          aria-pressed="false"
          data-reels-toggle
          data-pause={reelsSection.pause}
          data-play={reelsSection.play}
        >
          {reelsSection.pause}
        </button>
        <p>{reelsSection.note}</p>
      </div>
    </div>
  </div>
)}

<style>
  .reel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .inline {
    margin-top: var(--space-7);
  }

  /* The frame keeps a Reel's own shape: cropping to a phone's taller screen would cut into the client's work */
  .phone {
    justify-self: center;
    height: min(62svh, 30rem);
    aspect-ratio: 9 / 16;
    padding: var(--space-1);
    border-radius: var(--radius-phone);
    background: var(--color-ink);
    box-shadow: var(--shadow);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-phone-screen);
  }

  .title {
    font-size: var(--text-4);
    font-weight: 600;
    line-height: 1.25;
  }

  .story {
    margin-top: var(--space-1);
    max-width: var(--content-narrow);
    color: var(--text-muted);
    line-height: 1.4;
  }

  .stills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .stills button {
    position: relative;
    display: block;
    width: 3.25rem;
    height: 4.5rem;
    overflow: hidden;
    border-radius: var(--radius-inner);
    transition: box-shadow var(--t-fast) var(--ease);
  }

  .stills img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stills button[aria-pressed="true"] {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--accent);
  }

  .tag {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0 var(--space-1);
    border-radius: var(--radius-tag) 0 0 0;
    background: var(--color-ink);
    color: var(--color-white);
    font: 500 var(--text-mono) / 1.5 var(--font-mono);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-small);
    line-height: 1.35;
  }

  .pause {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target);
    color: var(--text);
    font: 600 var(--text-small) / 1 var(--font-body);
  }

  .pause::before {
    content: "";
    width: 0.7rem;
    height: 0.8rem;
    background: linear-gradient(90deg, var(--accent) 35%, transparent 35% 65%, var(--accent) 65%);
  }

  .pause[aria-pressed="true"]::before {
    background: var(--accent);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  @media (min-width: 1024px) {
    .reel {
      grid-template-columns: 5fr 7fr;
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        "phone ."
        "phone head"
        "phone words"
        "phone .";
      gap: var(--space-5) var(--space-9);
    }

    .inline {
      grid-template-columns: 2fr 3fr;
    }

    .phone {
      grid-area: phone;
      height: min(80svh, 40rem);
    }

    .head {
      grid-area: head;
    }

    .words {
      grid-area: words;
    }

    .stills button {
      width: 4rem;
      height: 5.5rem;
    }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>("[data-reel-box]");
  const video = box?.querySelector<HTMLVideoElement>("[data-reel]");
  if (box && video) {
    const toggle = box.querySelector<HTMLButtonElement>("[data-reels-toggle]")!;
    const title = box.querySelector<HTMLElement>("[data-reel-title]")!;
    const story = box.querySelector<HTMLElement>("[data-reel-story]")!;
    const picks = [...box.querySelectorAll<HTMLButtonElement>("[data-reel-pick]")];
    let paused = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = false;

    const sync = () => {
      if (!paused && visible) void video.play().catch(() => {});
      else video.pause();
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };

    new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        sync();
      },
      { threshold: 0.4 },
    ).observe(video);

    toggle.addEventListener("click", () => {
      paused = !paused;
      sync();
    });

    for (const pick of picks) {
      pick.addEventListener("click", () => {
        video.src = pick.dataset.video!;
        video.poster = pick.dataset.poster!;
        video.setAttribute("aria-label", pick.dataset.alt!);
        title.textContent = pick.dataset.title!;
        story.textContent = pick.dataset.story!;
        for (const other of picks) other.setAttribute("aria-pressed", String(other === pick));
        sync();
      });
    }
    sync();
  }
</script>
