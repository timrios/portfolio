---
// Daylight or after hours, the visitor's choice. The page head already applied a saved choice (or dark) before
// painting; this button switches and remembers. Where the browser supports it, the new look spreads in a circle from
// the button. Round icon in the desktop plate; `labeled` is the row in the phone menu.
import { site } from "../data/site";

interface Props {
  labeled?: boolean;
}

const { labeled = false } = Astro.props;
---

<button
  type="button"
  class:list={["toggle", { labeled }]}
  aria-pressed="false"
  data-theme-toggle
  data-to-light={site.theme.toLight}
  data-to-dark={site.theme.toDark}
>
  <span class:list={{ "visually-hidden": !labeled }} data-theme-label>
    {site.theme.toDark}
  </span>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"></path>
  </svg>
</button>

<style>
  .toggle {
    display: inline-grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border-radius: var(--radius-inner);
    color: inherit;
    transition: background-color var(--t-fast) var(--ease);
  }

  .toggle:hover {
    background: var(--plate-hover);
  }

  .labeled {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: auto;
    min-height: 3.5rem;
    font-weight: 500;
    text-align: left;
  }

  svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Shows the look it switches to */
  .sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .sun {
    display: block;
  }

  :global(html[data-theme="dark"]) .moon {
    display: none;
  }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")];
  const root = document.documentElement;

  const reflect = () => {
    const dark = root.dataset.theme === "dark";
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(dark));
      button.querySelector("[data-theme-label]")!.textContent = dark
        ? button.dataset.toLight!
        : button.dataset.toDark!;
    }
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      const apply = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        reflect();
      };
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || still) return apply();
      // The new look grows in a circle from the button
      const box = button.getBoundingClientRect();
      const x = box.left + box.width / 2;
      const y = box.top + box.height / 2;
      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      const sweep = getComputedStyle(root).getPropertyValue("--t-sweep");
      const ease = getComputedStyle(root).getPropertyValue("--ease");
      root.classList.add("theme-sweep");
      const sweepIn = document.startViewTransition(apply);
      void sweepIn.finished.finally(() => root.classList.remove("theme-sweep"));
      sweepIn.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
          {
            // The build's minifier may write the token in seconds (.52s), so read either unit
            duration: parseFloat(sweep) * (sweep.trim().endsWith("ms") ? 1 : 1000),
            easing: ease,
            pseudoElement: "::view-transition-new(root)",
          },
        );
      });
    });
  }
  reflect();
</script>

<style is:global>
  /* The circle replaces the browser's default cross-fade, for this switch only: moving between pages keeps the fade */
  /* A card keeps its page-to-page name otherwise, and would cross-fade on its own above the circle */
  .theme-sweep * {
    view-transition-name: none !important;
  }

  .theme-sweep::view-transition-old(root),
  .theme-sweep::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>
