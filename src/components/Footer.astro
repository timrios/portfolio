---
import { site } from "../data/site";
---

<footer class="footer container">
  <p><strong>{site.name}</strong></p>
  <p>{site.footer.about.replace("{city}", site.city)}</p>
  <p class="contact">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={`sms:${site.phoneSms}`}>{site.phone}</a>
  </p>
  <p class="door">
    {site.footer.hiring}{" "}
    <a class="link" href="/resume/">{site.footer.resume}</a>
    {" "}{site.footer.or}{" "}
    <a class="link" href="/how-this-site-was-built/">{site.footer.buildNotes}</a>
  </p>
  <p>© {new Date().getFullYear()}</p>
</footer>

<style>
  .footer {
    padding-block: var(--space-5) var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  strong {
    color: var(--text);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text);
  }

  .contact a {
    margin-right: var(--space-5);
  }
</style>
