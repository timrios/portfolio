---
import { site } from "../data/site";
---

<footer class="footer deep">
  <div class="container inner">
    <p>
      <strong>{site.name}</strong>
      <span class="muted">{site.footer.about.replace("{city}", `${site.city}, Texas`)}</span>
    </p>
    <p class="contact">
      <a class="link" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <a class="link" href={`sms:${site.phoneSms}`}>
        {site.phone}
      </a>
      <span class="muted">© {new Date().getFullYear()}</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-7) var(--space-8);
    font-size: var(--text-small);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }

  .inner p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    align-items: center;
  }

  .contact a {
    display: inline-block;
    margin-block: var(--space-2);
  }
</style>
