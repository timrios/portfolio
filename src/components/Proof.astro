---
// A print proof: the slot's content framed by crop marks in Tim's ink, with an optional caption row in mono.
interface Props {
  /** Left and right captions under the print, e.g. a name and a place */
  caption?: [string, string];
  class?: string;
}

const { caption, class: className } = Astro.props;
---

<figure class:list={["proof", className]}>
  <span class="marks" aria-hidden="true"></span>
  <slot />
  {caption && (
    <figcaption class="mono">
      <span>{caption[0]}</span>
      <span>{caption[1]}</span>
    </figcaption>
  )}
</figure>

<style>
  .proof {
    position: relative;
    padding: var(--space-6);
  }

  /* Four crop marks, the trim guides a printer cuts to */
  .proof::before,
  .proof::after,
  .marks::before,
  .marks::after {
    content: "";
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 0 solid var(--accent);
  }

  .proof::before {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }

  .proof::after {
    top: 0;
    right: 0;
    border-width: 1px 1px 0 0;
  }

  .marks::before {
    bottom: 0;
    left: 0;
    border-width: 0 0 1px 1px;
  }

  .marks::after {
    bottom: 0;
    right: 0;
    border-width: 0 1px 1px 0;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
    color: var(--text-muted);
  }
</style>
