---
// Before and after for one project: a slider wipes between the old site and the new one (a real range input, so the
// keyboard works). Without an old site, a short description stands in for "before". Used on the home page and on
// project pages.
import Img from "./Img.astro";
import type { Project } from "../data/projects";
import { projects } from "../data/projects";
import { site } from "../data/site";

interface Props {
  project: Project;
  /** Rendered width hint for the images */
  sizes: string;
}

const { project, sizes } = Astro.props;
const before = project.before.image;
const h = site.home;
// Each client's light breathes out of step with the others
const delay = projects.findIndex((p) => p.id === project.id) * -2.3;
---

<div class="lit" style={`--client: ${project.accent}; --delay: ${delay}s`}>
  <div class="light" aria-hidden="true"></div>

  {before ? (
    <div class="frame" style="--split: 50%" data-compare>
      <Img src={project.screens.desktop.src} alt={project.screens.desktop.alt} sizes={sizes} />
      <div class="before-layer">
        <Img src={before.src} alt={before.alt} sizes={sizes} />
      </div>
      <span class="tag tag-before" aria-hidden="true">
        {h.beforeLabel}
      </span>
      <span class="tag tag-after" aria-hidden="true">
        {h.afterLabel}
      </span>
      <span class="handle" aria-hidden="true" />
      <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label={`${h.sliderLabel}: ${project.name}`}
      />
    </div>
  ) : (
    <div class="pair">
      <p class="none">
        <span class="tag static">{h.beforeLabel}</span>
        {project.beforeShort}
      </p>
      <div class="frame">
        <Img src={project.screens.desktop.src} alt={project.screens.desktop.alt} sizes={sizes} />
        <span class="tag tag-after" aria-hidden="true">
          {h.afterLabel}
        </span>
      </div>
    </div>
  )}
</div>

<style>
  /* The client's color breathing behind the work */
  .lit {
    position: relative;
    isolation: isolate;
  }

  .light {
    position: absolute;
    z-index: -1;
    inset: -22% -16%;
    pointer-events: none;
    filter: blur(70px);
    background:
      radial-gradient(45% 50% at 35% 40%, var(--client), transparent 72%),
      radial-gradient(
        35% 40% at 70% 65%,
        color-mix(in srgb, var(--client) 70%, var(--accent)),
        transparent 72%
      );
    opacity: 0.6;
    animation: breathe 7s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  @keyframes breathe {
    from {
      opacity: 0.3;
      scale: 0.88;
    }
    to {
      opacity: 0.95;
      scale: 1.14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .light {
      animation: none;
    }
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-screen);
    box-shadow: var(--shadow);
    background: var(--surface);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  /* Drag anywhere on the picture. pan-y keeps up-and-down swipes scrolling the page and hands sideways ones to the
     script. The images ignore touches, so a press doesn't drag the picture or open the phone's image menu. */
  [data-compare] {
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  [data-compare] :global(img) {
    pointer-events: none;
  }

  /* The old site sits on top, cut away to the right of the split */
  .before-layer {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  /* The handle and tags sit on client screenshots in both looks, so they use fixed white and ink */
  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background: var(--color-white);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-black) 25%, transparent);
    pointer-events: none;
  }

  .handle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-white);
    box-shadow: var(--shadow);
    /* Two chevrons, one each way: it drags both directions. Each chevron is two short strokes. */
    --stroke: transparent 44%, var(--color-ink) 44% 56%, transparent 56%;
    background-image:
      linear-gradient(135deg, var(--stroke)), linear-gradient(45deg, var(--stroke)),
      linear-gradient(45deg, var(--stroke)), linear-gradient(135deg, var(--stroke));
    background-size: 0.5rem 0.5rem;
    background-repeat: no-repeat;
    background-position:
      30% 40%,
      30% 60%,
      70% 40%,
      70% 60%;
  }

  /* The range input stays for the keyboard and screen readers. It takes no pointer input, because phones only drag a
     slider by its thumb; the script handles dragging on the frame instead. */
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .frame:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .tag {
    position: absolute;
    top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-ink) 72%, transparent);
    color: var(--color-white);
    font-size: 0.8125rem;
    font-weight: 600;
    pointer-events: none;
  }

  .tag-before {
    left: var(--space-3);
  }

  .tag-after {
    right: var(--space-3);
  }

  /* Phones stack the note above the screenshot: a column beside it is too narrow for the words */
  .pair {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .pair {
      grid-template-columns: 2fr 5fr;
    }

    .pair .frame {
      align-self: center;
    }
  }

  /* No fixed shape: the box grows with its text and stretches to the screenshot's height beside it */
  .none {
    display: grid;
    align-content: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--field-border);
    border-radius: var(--radius-screen);
    color: var(--text-muted);
    font-size: var(--text-small);
    text-align: center;
  }

  .tag.static {
    position: static;
    justify-self: center;
  }
</style>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>("[data-compare]")) {
    const input = frame.querySelector("input")!;
    const show = (percent: number) => {
      const split = Math.min(100, Math.max(0, percent));
      input.value = String(split);
      frame.style.setProperty("--split", `${split}%`);
    };
    input.addEventListener("input", () => show(Number(input.value)));

    // A mouse jumps to where it presses. A finger moves the split by how far it travels, so starting a swipe doesn't
    // make the picture jump. If the swipe turns out to be a page scroll, the browser cancels it.
    let drag: { startX: number; startSplit: number } | null = null;
    const toPercent = (pixels: number) => (pixels / frame.clientWidth) * 100;

    frame.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0) return;
      if (event.pointerType === "mouse") {
        show(toPercent(event.clientX - frame.getBoundingClientRect().left));
      }
      drag = { startX: event.clientX, startSplit: Number(input.value) };
      frame.setPointerCapture(event.pointerId);
    });
    frame.addEventListener("pointermove", (event) => {
      if (drag) show(drag.startSplit + toPercent(event.clientX - drag.startX));
    });
    const stop = () => {
      drag = null;
    };
    frame.addEventListener("pointerup", stop);
    frame.addEventListener("pointercancel", stop);
  }
</script>
