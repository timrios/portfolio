---
// Before and after for one project: a slider wipes between the old site and the new one (a real range input, so the
// keyboard works). Phones see phone captures in a tall frame, desktops the desktop captures; each size loads only its
// own pictures. Without an old site, a short note stands in for "before". Used on the home and project pages.
import Img from "./Img.astro";
import Star from "./Star.astro";
import type { Project } from "../data/projects";
import { site } from "../data/site";

interface Props {
  project: Project;
  /** Rendered width hint for the wide pictures */
  sizes: string;
}

const { project, sizes } = Astro.props;
const h = site.home;
const beforeWide = project.before.image;
const beforeAlt = beforeWide?.alt ?? "";
---

<div class="cmp" style="--split: 50%" data-compare>
  <div class="set only-phone">
    <Img src={project.screens.phone.src} alt={project.screens.phone.alt} sizes="100vw" />
    {project.hero.beforePhone ? (
      <div class:list={["old", { fit: project.hero.beforeFit }]}>
        <Img src={project.hero.beforePhone} alt={beforeAlt} sizes="100vw" />
      </div>
    ) : (
      <div class="old note"><p>{project.beforeShort}</p></div>
    )}
  </div>
  <div class="set only-wide">
    <Img src={project.screens.desktop.src} alt={project.screens.desktop.alt} sizes={sizes} />
    {beforeWide ? (
      <div class="old">
        <Img src={beforeWide.src} alt={beforeAlt} sizes={sizes} />
      </div>
    ) : (
      <div class="old note"><p>{project.beforeShort}</p></div>
    )}
  </div>
  <span class="tag before" aria-hidden="true">{h.beforeLabel}</span>
  <span class="tag after" aria-hidden="true">{h.afterLabel}</span>
  <span class="seam" aria-hidden="true">
    <span class="grip"><Star /></span>
  </span>
  <input
    type="range"
    min="0"
    max="100"
    value="50"
    aria-label={`${h.sliderLabel}: ${project.name}`}
  />
</div>

<style>
  /* Drag anywhere on the picture. pan-y keeps up-and-down swipes scrolling the page and hands sideways ones to the
     script. The images ignore touches, so a press doesn't drag the picture or open the phone's image menu. */
  .cmp {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--band);
    box-shadow:
      0 0 0 1px var(--rule),
      var(--shadow);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .set,
  .old {
    position: absolute;
    inset: 0;
  }

  .cmp :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    pointer-events: none;
  }

  /* The old site sits on top, cut away to the right of the split */
  .old {
    background: var(--band);
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .old.fit :global(img) {
    object-fit: contain;
  }

  /* The note keeps its width while the split passes over it, so its words don't reflow */
  .note {
    display: flex;
    align-items: center;
    padding: var(--space-4);
  }

  .note p {
    width: min(8rem, 36vw);
    color: var(--text);
    font-weight: 600;
    line-height: 1.25;
  }

  /* The tags and the seam sit on client screenshots in both looks, so they use fixed colors */
  .tag {
    position: absolute;
    top: var(--space-2);
    z-index: 2;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-tag);
    background: var(--color-ink);
    color: var(--color-white);
    font: 500 var(--text-mono) / 1 var(--font-mono);
    pointer-events: none;
  }

  .before {
    left: var(--space-2);
  }

  .after {
    right: var(--space-2);
  }

  .seam {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 1px;
    background: var(--color-white);
    box-shadow: 0 0 0 0.5px color-mix(in oklch, var(--color-ink) 35%, transparent);
    pointer-events: none;
  }

  .grip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--color-oak-deep);
    color: var(--color-marigold);
    box-shadow:
      0 0 0 3px color-mix(in oklch, var(--color-white) 92%, transparent),
      0 8px 20px -4px color-mix(in oklch, var(--color-black) 50%, transparent);
  }

  .grip :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }

  /* The range input stays for the keyboard and screen readers. It takes no pointer input, because phones only drag a
     slider by its thumb; the script handles dragging on the frame instead. */
  input {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .cmp:has(input:focus-visible) .grip {
    outline: 2px solid var(--color-marigold);
    outline-offset: 5px;
  }

  @media (min-width: 1024px) {
    .cmp {
      aspect-ratio: 16 / 10;
    }

    .note p {
      width: 12rem;
    }
  }
</style>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>("[data-compare]")) {
    const input = frame.querySelector("input")!;
    const show = (percent: number) => {
      const split = Math.min(100, Math.max(0, percent));
      input.value = String(split);
      frame.style.setProperty("--split", `${split}%`);
    };
    input.addEventListener("input", () => show(Number(input.value)));

    // A mouse jumps to where it presses. A finger moves the split by how far it travels, so starting a swipe doesn't
    // make the picture jump. If the swipe turns out to be a page scroll, the browser cancels it.
    let drag: { startX: number; startSplit: number } | null = null;
    const toPercent = (pixels: number) => (pixels / frame.clientWidth) * 100;

    frame.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0) return;
      if (event.pointerType === "mouse") {
        show(toPercent(event.clientX - frame.getBoundingClientRect().left));
      }
      drag = { startX: event.clientX, startSplit: Number(input.value) };
      frame.setPointerCapture(event.pointerId);
    });
    frame.addEventListener("pointermove", (event) => {
      if (drag) show(drag.startSplit + toPercent(event.clientX - drag.startX));
    });
    const stop = () => {
      drag = null;
    };
    frame.addEventListener("pointerup", stop);
    frame.addEventListener("pointercancel", stop);
  }
</script>
