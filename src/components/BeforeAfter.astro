---
// One project on the home page: name and kind, its before-and-after slider, the outcome, and links to the story and to
// the live site in the preview window. Phones read straight down; desktops zigzag slider and words.
import CompareSlider from "./CompareSlider.astro";
import ProjectPreview from "./ProjectPreview.astro";
import type { Project } from "../data/projects";
import { site } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="row" style={`--client: ${project.accent}`} aria-labelledby={`ba-${project.id}`}>
  <div class="head">
    <h3 id={`ba-${project.id}`}>{project.name}</h3>
    <p class="kind">
      <i aria-hidden="true"></i>
      <span>
        {project.hero.kindLine}{project.status === "in-progress" && `. ${site.projectLabels.inProgress}`}
      </span>
    </p>
  </div>
  <div class="compare">
    <CompareSlider project={project} sizes="(min-width: 1024px) 50vw, 100vw" />
  </div>
  <div class="rest">
    <p class="outcome">{project.outcome}</p>
    <p class="links">
      <a
        href={`/work/${project.id}/`}
        aria-label={site.home.storyLabel.replace("{who}", project.name)}
      >
        {site.preview.story}
      </a>
      <button type="button" data-open-preview={project.id}>{site.preview.open}</button>
    </p>
  </div>
  <ProjectPreview project={project} />
</article>

<style>
  .row {
    margin-top: var(--space-7);
  }

  h3 {
    font-size: var(--text-3);
  }

  .kind {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  .kind i {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--client);
    box-shadow: 0 0 0 1px var(--rule);
  }

  .outcome {
    margin-top: var(--space-3);
    font-size: var(--text-4);
    font-weight: 560;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-top: var(--space-1);
  }

  .links a,
  .links button {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--accent);
    font-size: var(--text-ui);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  @media (min-width: 1024px) {
    .row {
      display: grid;
      grid-template-columns: 7fr 5fr;
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        "cmp ."
        "cmp head"
        "cmp rest"
        "cmp .";
      column-gap: var(--space-9);
      margin-top: var(--space-9);
    }

    .row:nth-of-type(even) {
      grid-template-columns: 5fr 7fr;
      grid-template-areas:
        ". cmp"
        "head cmp"
        "rest cmp"
        ". cmp";
    }

    .head {
      grid-area: head;
    }

    .compare {
      grid-area: cmp;
    }

    .rest {
      grid-area: rest;
    }
  }
</style>
