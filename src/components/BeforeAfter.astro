---
// One project on the home page: its before-and-after slider, and beside it the name, kind, the outcome in bold, and
// links to the story and to the live site in the preview window.
import CompareSlider from "./CompareSlider.astro";
import ProjectPreview from "./ProjectPreview.astro";
import type { Project } from "../data/projects";
import { site } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="row" style={`--client: ${project.accent}`} aria-labelledby={`ba-${project.id}`}>
  <div class="compare">
    <CompareSlider project={project} sizes="(min-width: 1024px) 50vw, 100vw" />
  </div>
  <div class="text">
    <h3 id={`ba-${project.id}`}>
      <span class="marker" aria-hidden="true"></span>
      {project.name}
      {project.status === "in-progress" && (
        <span class="status">{site.projectLabels.inProgress}</span>
      )}
    </h3>
    <p class="kind">
      {project.kind}, {project.place}
    </p>
    <p class="outcome">{project.outcome}</p>
    <p class="services">{project.services.join(", ")}</p>
    <p class="links">
      <a class="link" href={`/work/${project.id}/`}>
        {site.preview.story}
      </a>
      <button type="button" class="open link" data-open-preview={project.id}>
        {site.preview.open}
      </button>
    </p>
  </div>
  <ProjectPreview project={project} />
</article>

<style>
  .row {
    display: grid;
    gap: var(--space-5) var(--space-8);
    align-items: center;
    padding-block: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .marker {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-right: 0.45em;
    border-radius: 2px;
    background: var(--client);
    box-shadow: 0 0 0 1px var(--field-border);
    vertical-align: 0.05em;
  }

  .status {
    margin-left: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--band);
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 0.15em;
  }

  .kind {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  .outcome {
    margin-top: var(--space-4);
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .services {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-5);
  }

  /* The button looks like its neighbouring link (global .link style); only the browser's button chrome is removed */
  /* Standalone links get room above the text for a 44px target; the bar stays right under the words */
  .links .link {
    padding-top: 0.85rem;
  }

  .open {
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .row {
      grid-template-columns: 7fr 5fr;
    }
  }
</style>
