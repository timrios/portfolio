---
// Phones: the logo plate, which scrolls away (the dock takes over). Desktop: two solid plates pinned at the top, the
// logo and the menu, with the page showing between them.
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";
---

<header class="top">
  <a class="plate wordmark" href="/" aria-label={`${site.domain}, home`}>
    <Logo />
  </a>
  <nav class="plate menu only-wide" aria-label="Main">
    {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    <ThemeToggle />
    <a class="text" href={`sms:${site.phoneSms}`}>{site.home.textAction}</a>
  </nav>
</header>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--gutter);
    pointer-events: none;
  }

  .plate {
    display: flex;
    align-items: center;
    pointer-events: auto;
    border-radius: var(--radius-plate);
    background: var(--plate);
    color: var(--on-plate);
    box-shadow:
      0 0 0 1px var(--rule),
      0 12px 24px -14px color-mix(in oklch, var(--shadow-tint) 60%, transparent);
  }

  .plate :focus-visible,
  .plate:focus-visible {
    outline-color: var(--color-marigold);
  }

  .wordmark {
    min-height: var(--target);
    padding-inline: var(--space-3);
  }

  .wordmark :global(svg) {
    height: 0.82rem;
  }

  .menu {
    gap: var(--space-1);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-2);
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-inner);
    color: inherit;
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }

  .menu a:hover {
    background: var(--plate-hover);
  }

  .menu .text {
    margin-left: var(--space-1);
    padding-inline: var(--space-4);
    background: var(--marigold);
    color: var(--on-marigold);
    font-weight: 620;
  }

  .menu .text:hover {
    background: color-mix(in oklch, var(--marigold) 86%, var(--color-white));
  }

  @media (min-width: 1024px) {
    .top {
      position: sticky;
      top: var(--space-3);
      z-index: 30;
      margin-top: var(--space-3);
      padding-block: 0;
    }

    .wordmark {
      min-height: 3.25rem;
      padding-inline: var(--space-4);
    }

    .wordmark :global(svg) {
      height: 0.885rem;
    }
  }
</style>
