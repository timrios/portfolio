---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";
---

<header class="header container">
  <!-- Plain wordmark until the logo is designed (README → Not started) -->
  <a class="wordmark" href="/">
    {site.domain}
  </a>
  <nav aria-label="Main">
    <ul>
      {site.navigation.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="actions">
    <a class="btn btn--ghost text" href={`sms:${site.phoneSms}`}>
      <span class="label">{site.home.textAction}</span>
      <span class="number">{site.phone}</span>
    </a>
    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 5rem;
  }

  .wordmark {
    margin-right: auto;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    padding-block: var(--space-3);
  }

  ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-small);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .text {
    min-height: 44px;
    padding-inline: var(--space-4);
    font-size: var(--text-small);
  }

  /* Phones show "Text me"; wider screens show the number itself */
  .number {
    display: none;
  }

  @media (min-width: 640px) {
    .label {
      display: none;
    }

    .number {
      display: inline;
    }
  }

  /* Phones: the links drop to their own row under the wordmark */
  @media (max-width: 899px) {
    .header {
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: var(--space-2);
    }

    nav {
      order: 3;
      width: 100%;
      border-top: 1px solid var(--rule);
    }

    ul {
      gap: var(--space-5);
      overflow-x: auto;
    }
  }
</style>
