---
// The invitation that ends the home and project pages: a text, or a free quote
import { site } from "../data/site";
---

<section class="on-deep deep closing" aria-labelledby="closing-heading" data-closing>
  <div class="container">
    <h2 id="closing-heading">{site.home.closingHeading}</h2>
    <p class="lede">
      {site.home.closingText.replace("{name}", site.name).replace("{city}", site.city)}
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={`sms:${site.phoneSms}`}>
        {site.home.textAction}: {site.phone}
      </a>
      <a class="btn btn--ghost" href={site.home.primaryAction.href}>
        {site.home.primaryAction.label}
      </a>
    </div>
  </div>
</section>

<style>
  .closing {
    margin-top: var(--space-7);
    padding-block: var(--space-8);
  }

  h2 {
    max-width: 20ch;
  }

  .lede {
    margin-top: var(--space-3);
  }

  .actions {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  @media (min-width: 640px) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>
