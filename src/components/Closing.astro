---
// The invitation that ends the home and project pages: a free plan, or a text
import { site } from "../data/site";
---

<section class="on-deep deep closing" aria-labelledby="closing-heading">
  <div class="container inner">
    <h2 id="closing-heading">{site.home.closingHeading}</h2>
    <p class="lede">{site.home.closingText}</p>
    <div class="actions">
      <a class="btn btn--primary" href={site.home.primaryAction.href}>
        {site.home.primaryAction.label}
      </a>
      <a class="btn btn--ghost" href={`sms:${site.phoneSms}`}>
        {site.home.textAction}: {site.phone}
      </a>
    </div>
  </div>
</section>

<style>
  /* The glow sits to the right here, so it doesn't repeat the results band's */
  .closing::before {
    inset: -60% -10% -60% 40%;
  }

  .closing {
    margin-top: var(--section);
    padding-block: var(--space-9);
  }

  .inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  h2 {
    max-width: 20ch;
  }

  .lede {
    margin-top: var(--space-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
