---
// The steps of a project, numbered because they happen in this order. A line runs through the numbers and draws
// itself once when it comes into view.
import { process } from "../data/process";
---

<ol class="steps" data-steps>
  {process.map((step) => (
    <li>
      <h3>{step.name}</h3>
      <p>{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    --drawn: 1;
    counter-reset: step;
    position: relative;
    display: grid;
    gap: var(--space-7);
    padding: 0;
    list-style: none;
  }

  li {
    counter-increment: step;
    position: relative;
  }

  li::before {
    content: counter(step);
    display: block;
    margin-bottom: var(--space-4);
    font: 720 var(--text-1) / 1 var(--font-display);
    font-variation-settings:
      "opsz" 96,
      "wdth" 98;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  p {
    margin-top: var(--space-2);
    color: var(--text-muted);
    max-width: var(--content-narrow);
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-5);
      padding-top: var(--space-5);
    }

    /* The line: drawn along the top, left to right, from a hidden start the script sets */
    .steps::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--accent);
      transform: scaleX(var(--drawn));
      transform-origin: left;
      transition: transform 1.4s var(--ease-build);
    }
  }
</style>

<script>
  const steps = document.querySelector<HTMLElement>("[data-steps]");
  if (steps && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    steps.style.setProperty("--drawn", "0");
    const watcher = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          steps.style.setProperty("--drawn", "1");
          watcher.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    watcher.observe(steps);
  }
</script>
