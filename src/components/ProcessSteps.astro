---
// The steps of a project, numbered because they happen in this order, on a rail: down the side on a phone, across the
// top on a desktop.
import { process } from "../data/process";
---

<ol class="steps">
  {process.map((step) => (
    <li>
      <h3>{step.name}</h3>
      <p>{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    counter-reset: step;
    padding: 0;
    list-style: none;
  }

  li {
    --dot: 2.25rem;
    counter-increment: step;
    position: relative;
    display: grid;
    grid-template-columns: var(--dot) minmax(0, 1fr);
    column-gap: var(--space-3);
    padding-bottom: var(--space-5);
  }

  li::before {
    content: counter(step);
    grid-row: 1 / 3;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--action);
    color: var(--on-action);
    font-size: var(--text-small);
    font-weight: 620;
  }

  /* The rail, from this number to the next */
  li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--dot) / 2 - 1px);
    width: 2px;
    background: var(--rule);
  }

  h3 {
    font-size: var(--text-body);
    font-weight: 620;
    letter-spacing: 0;
    line-height: var(--dot);
  }

  p {
    grid-column: 2;
    color: var(--text-muted);
    font-size: var(--text-ui);
    line-height: 1.38;
  }

  @media (min-width: 1024px) {
    .steps {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-5);
    }

    li {
      display: block;
      padding: 0;
    }

    li::before {
      position: relative;
    }

    li:not(:last-child)::after {
      top: calc(var(--dot) / 2 - 1px);
      bottom: auto;
      left: 0;
      right: calc(-1 * var(--space-5));
      width: auto;
      height: 2px;
    }

    h3 {
      margin-top: var(--space-3);
      line-height: 1.25;
    }

    p {
      margin-top: var(--space-1);
    }
  }
</style>
