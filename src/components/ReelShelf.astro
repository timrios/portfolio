---
// Reels as silent previews in phone frames. They load nothing until they come near the screen, play only while
// visible, start paused under reduced motion, and one button pauses them all (motion the visitor didn't start must be
// stoppable).
import { reels, reelsSection } from "../data/reels";
import { projects } from "../data/projects";

interface Props {
  /** Show only this project's Reels, without the section heading (inside a project page) */
  projectId?: string;
}

const { projectId } = Astro.props;
const clients = new Map(projects.map((project) => [project.id, project]));
const shown = projectId ? reels.filter((reel) => reel.projectId === projectId) : reels;
const Wrapper = projectId ? "div" : "section";
---

<Wrapper
  class:list={["reels", { container: !projectId, section: !projectId, inline: projectId }]}
  aria-labelledby={projectId ? undefined : "reels-heading"}
>
  {!projectId && (
    <div class="head">
      <h2 id="reels-heading">{reelsSection.heading}</h2>
      <p class="lede">{reelsSection.intro}</p>
    </div>
  )}
  <ul class="shelf">
    {shown.map((reel) => (
      <li style={`--client: ${clients.get(reel.projectId)?.accent}`}>
        <div class="device">
          <video
            src={`/media/reels/${reel.video}`}
            poster={`/media/reels/${reel.poster}`}
            muted
            loop
            playsinline
            preload="none"
            aria-label={reel.alt}
            data-reel
          />
        </div>
        <p class="title">
          {reel.title}
          {reel.ai && <span class="tag mono">{reelsSection.aiLabel}</span>}
        </p>
        <p class="caption">{reel.caption}</p>
      </li>
    ))}
  </ul>
  <div class="controls">
    <button
      type="button"
      aria-pressed="false"
      data-reels-toggle
      data-pause={reelsSection.pause}
      data-play={reelsSection.play}
    >
      {reelsSection.pause}
    </button>
    <p>{reelsSection.note}</p>
  </div>
</Wrapper>

<style>
  .head {
    display: grid;
    gap: var(--space-5);
  }

  .head h2 {
    max-width: 20ch;
  }

  .inline .shelf {
    margin-top: var(--space-6);
  }

  .shelf {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 16rem);
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding: 0 0 var(--space-4);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .shelf li {
    scroll-snap-align: start;
  }

  .device {
    aspect-ratio: 9 / 16;
    padding: var(--space-2);
    border-radius: 1.75rem;
    background: var(--surface);
    outline: 1px solid var(--rule);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1.3rem;
  }

  .title {
    margin-top: var(--space-4);
    font-weight: 600;
  }

  .tag {
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    border: 1px solid var(--client);
    font-weight: 400;
  }

  .caption {
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .controls button {
    all: unset;
    cursor: pointer;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-weight: 600;
    font-size: var(--text-body);
  }

  /* Pause bars while playing, a play triangle while paused: the button's shape matches its action */
  .controls button::before {
    content: "";
    width: 0.7rem;
    height: 0.8rem;
    background: linear-gradient(90deg, var(--accent) 35%, transparent 35% 65%, var(--accent) 65%);
  }

  .controls button[aria-pressed="true"]::before {
    background: var(--accent);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .controls button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }

    .shelf {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
    }

    /* Alternate phones sit lower, like devices lined up on a counter */
    .shelf li:nth-child(odd) {
      transform: translateY(var(--space-7));
    }

    .controls {
      margin-top: var(--space-10);
    }
  }
</style>

<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>("[data-reel]")];
  const toggles = [...document.querySelectorAll<HTMLButtonElement>("[data-reels-toggle]")];
  let paused = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const visible = new Set<HTMLVideoElement>();

  const sync = () => {
    for (const video of videos) {
      if (!paused && visible.has(video)) void video.play().catch(() => {});
      else video.pause();
    }
    for (const toggle of toggles) {
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
    }
  };

  const watcher = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) visible.add(video);
        else visible.delete(video);
      }
      sync();
    },
    { threshold: 0.4 },
  );
  videos.forEach((video) => watcher.observe(video));

  for (const toggle of toggles) {
    toggle.addEventListener("click", () => {
      paused = !paused;
      sync();
    });
  }
  sync();
</script>
