---
// The home page's opening: the promise, ending in a text cursor, and Tim's portrait printed as a halftone proof.
import Img from "./Img.astro";
import Proof from "./Proof.astro";
import { site } from "../data/site";
---

<section class="hero container" aria-labelledby="hero-heading">
  <div class="words">
    <h1 id="hero-heading" class="headline">
      {site.home.headline}
    </h1>
    <p class="lede">{site.home.lede}</p>
    <div class="actions">
      <a class="btn btn--primary" href={site.home.primaryAction.href}>
        {site.home.primaryAction.label}
      </a>
      <a class="btn btn--ghost" href={site.home.secondaryAction.href}>
        {site.home.secondaryAction.label}
      </a>
    </div>
  </div>
  <Proof class="portrait" caption={[site.name, `${site.city}, ${site.region}`]}>
    <div class="print">
      <Img
        src="tim/tim-rios-halftone.png"
        alt={site.home.portraitAlt}
        sizes="(min-width: 1024px) 34vw, 80vw"
        priority
      />
    </div>
  </Proof>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding-top: var(--space-6);
    padding-bottom: var(--section);
  }

  .headline {
    font-size: var(--text-display);
    line-height: 0.88;
  }

  /* The editor's cursor, in Tim's ink, closes the headline */
  .headline::after {
    content: "";
    display: inline-block;
    width: 0.38em;
    height: 0.72em;
    margin-left: 0.08em;
    vertical-align: -0.02em;
    background: var(--accent);
  }

  .lede {
    margin-top: var(--space-6);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* The halftone is ink only; the card it's printed on is Tim's yellow */
  .print {
    background: var(--accent);
  }

  .print :global(img) {
    width: 100%;
  }

  .hero :global(.portrait) {
    max-width: 30rem;
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 7fr 5fr;
      min-height: calc(100vh - 4.5rem);
      padding-bottom: var(--space-9);
    }

    .hero :global(.portrait) {
      justify-self: end;
      width: 100%;
    }
  }
</style>
