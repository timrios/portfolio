---
// "Sound familiar?": a deep band of huge statements. Each is what an owner says out loud, with what I do about it and
// a real example beside it.
import { services } from "../data/services";
import { projects } from "../data/projects";
import { site } from "../data/site";

const published = new Map(projects.map((project) => [project.id, project]));
---

<section class="on-deep deep statements-band" aria-labelledby="services-heading">
  <div class="container">
    <h2 id="services-heading">{site.home.servicesHeading}</h2>
    <ul class="statements">
      {services.map((service) => {
        const project = published.get(service.proof.projectId);
        return (
          <li>
            <p class="problem">“{service.problem}”</p>
            <div class="answer">
              <p class="text">{service.text}</p>
              {project && (
                <a class="link proof" href={`/work/${project.id}/`}>
                  {service.proof.text}
                </a>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .statements-band {
    padding-block: var(--section);
  }

  h2 {
    font-size: var(--text-3);
    font-weight: 600;
    font-variation-settings:
      "opsz" 32,
      "wdth" 100;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .statements {
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    padding-block: var(--space-6);
  }

  .problem {
    font-size: var(--text-2);
    font-weight: 720;
    font-variation-settings:
      "opsz" 96,
      "wdth" 98;
    letter-spacing: -0.032em;
    line-height: 1.04;
    text-wrap: balance;
    transition: color 0.25s;
  }

  li:hover .problem {
    color: var(--accent);
  }

  .answer {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .text {
    color: var(--text-muted);
  }

  /* These run to two lines, where the bar-style link would sit under the whole block */
  .proof {
    padding: 0;
    background: none;
    color: var(--text);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .proof:hover {
    color: var(--accent);
  }

  @media (min-width: 1024px) {
    li {
      grid-template-columns: 7fr 5fr;
    }
  }
</style>
