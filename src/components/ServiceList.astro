---
// "Sound familiar?": what owners say out loud, each opening on what I do about it and a real example. Only one is open
// at a time, so the band stays short on a phone. The star turns as a row opens.
import Star from "./Star.astro";
import { services } from "../data/services";
import { projects } from "../data/projects";
import { site } from "../data/site";

const published = new Map(projects.map((project) => [project.id, project]));
---

<section class="on-deep deep statements" aria-labelledby="services-heading">
  <div class="container">
    <h2 id="services-heading">{site.home.servicesHeading}</h2>
    <div class="list">
      {services.map((service, i) => {
        const project = published.get(service.proof.projectId);
        return (
          <details name="services" open={i === 0}>
            <summary>
              “{service.problem}”
              <Star />
            </summary>
            <div class="answer">
              <p>{service.text}</p>
              {project && <a href={`/work/${project.id}/`}>{service.proof.text}</a>}
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>

<style>
  .statements {
    margin-block: var(--section);
    padding-block: var(--space-8);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.3;
  }

  details {
    border-top: 1px solid var(--rule);
  }

  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding-block: var(--space-4);
    font-size: var(--text-3);
    font-weight: 540;
    letter-spacing: -0.022em;
    line-height: 1.12;
    text-wrap: balance;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: var(--space-1);
    color: var(--marigold);
    transition: rotate var(--t-base) var(--ease);
  }

  details[open] summary :global(svg) {
    rotate: 72deg;
  }

  /* Answers slide open where the browser can animate to a natural height; elsewhere they simply appear */
  @media (prefers-reduced-motion: no-preference) {
    details {
      interpolate-size: allow-keywords;
    }

    details::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size var(--t-base) var(--ease),
        content-visibility var(--t-base) allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
    }
  }

  .answer {
    padding-bottom: var(--space-5);
    line-height: 1.42;
  }

  .answer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    margin-top: var(--space-1);
    color: var(--text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--marigold);
    text-underline-offset: 0.22em;
  }

  @media (min-width: 1024px) {
    .answer {
      max-width: var(--content-narrow);
    }
  }

  /* The star turns instantly under reduced motion */
  @media (prefers-reduced-motion: reduce) {
    summary :global(svg) {
      transition: none;
    }
  }
</style>
