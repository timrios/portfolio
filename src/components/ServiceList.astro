---
// "Sound familiar?": each service led by the problem an owner says out loud, then what I do, then a real example
import { services } from "../data/services";
import { projects } from "../data/projects";

const published = new Map(projects.map((project) => [project.id, project]));
---

<ul class="services">
  {services.map((service) => {
    const project = published.get(service.proof.projectId);
    return (
      <li>
        <p class="problem">“{service.problem}”</p>
        <p class="text">{service.text}</p>
        {project && (
          <a class="proof" href={`/work/${project.id}/`}>
            {service.proof.text}
          </a>
        )}
      </li>
    );
  })}
</ul>

<style>
  .services {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .problem {
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .text {
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  .proof {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-small);
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 768px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .services {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
