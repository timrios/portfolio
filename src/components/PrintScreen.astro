---
// The faint print screen behind every page (DESIGN.md → Principles 3 and 4). Dots rest in smoke; near the visitor's
// cursor they swell and take on Tim's ink. It never moves by itself, so it needs no pause control; on touch screens and
// with reduced motion it stays still.
---

<canvas class="print-screen" aria-hidden="true" data-print-screen></canvas>

<style>
  .print-screen {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media print {
    .print-screen {
      display: none;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-print-screen]");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) {
    const styles = getComputedStyle(document.documentElement);
    const ink = styles.getPropertyValue("--accent").trim();
    const rest = styles.getPropertyValue("--code").trim();
    const gap = 22;
    const reach = 240;
    const responsive = matchMedia(
      "(pointer: fine) and (prefers-reduced-motion: no-preference)",
    ).matches;
    let px = -9999;
    let py = -9999;
    let queued = false;

    const draw = () => {
      queued = false;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = innerWidth;
      const h = innerHeight;
      if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      for (let y = gap / 2; y < h; y += gap) {
        for (let x = gap / 2; x < w; x += gap) {
          const near = Math.max(0, 1 - Math.hypot(x - px, y - py) / reach);
          ctx.globalAlpha = 0.22 + near * 0.6;
          ctx.fillStyle = near > 0.02 ? ink : rest;
          ctx.beginPath();
          ctx.arc(x, y, 1 + near * 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(draw);
      }
    };

    if (responsive) {
      addEventListener("pointermove", (event) => {
        px = event.clientX;
        py = event.clientY;
        request();
      });
      document.documentElement.addEventListener("pointerleave", () => {
        px = py = -9999;
        request();
      });
    }
    addEventListener("resize", request);
    draw();
  }
</script>
