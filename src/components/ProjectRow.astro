---
// One project in the home page's work list. The row borrows the client's brand color for its marker and link.
import Img from "./Img.astro";
import type { Project } from "../data/projects";
import { site } from "../data/site";

interface Props {
  project: Project;
  /** The first row's images are near the top of the page */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
---

<article class="row" style={`--accent: ${project.accent}`} aria-labelledby={`${project.id}-name`}>
  <div class="text">
    <p class="mono path">
      {project.id}
      {project.status === "in-progress" && (
        <span class="status">{site.projectLabels.inProgress}</span>
      )}
    </p>
    <h3 id={`${project.id}-name`}>{project.name}</h3>
    <p class="business muted">
      {project.business}. {project.place}.
    </p>
    <p class="summary">{project.summary}</p>
    <ul class="services" aria-label="What I did">
      {project.services.map((service) => (
        <li>{service}</li>
      ))}
    </ul>
    <a class="more" href={`/work/${project.id}/`}>
      See the {project.name} project
    </a>
  </div>
  <a class="screens" href={`/work/${project.id}/`} tabindex="-1" aria-hidden="true">
    <span class="desktop">
      <Img
        src={project.screens.desktop.src}
        alt=""
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading={eager ? "eager" : "lazy"}
      />
    </span>
    <span class="phone">
      <Img src={project.screens.phone.src} alt="" sizes="(min-width: 1024px) 12vw, 30vw" />
    </span>
  </a>
</article>

<style>
  .row {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .path {
    color: var(--text-muted);
  }

  .path::before {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-right: 0.6em;
    vertical-align: -0.2em;
    background: var(--accent);
  }

  /* "In progress": an outlined tag in the client's color, so it reads as a state, not a link */
  .status {
    display: inline-block;
    margin-left: var(--space-3);
    padding: 0 var(--space-2);
    border: 1px solid var(--accent);
    color: var(--text);
  }

  h3 {
    margin-top: var(--space-3);
    font-size: var(--text-2);
    font-weight: 800;
    font-variation-settings:
      "opsz" 96,
      "wdth" 75;
    line-height: 0.95;
  }

  .business {
    margin-top: var(--space-3);
    font-size: var(--text-small);
  }

  .summary {
    margin-top: var(--space-4);
    max-width: var(--content-narrow);
  }

  .services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    font: var(--text-mono) / 1.5 var(--font-mono);
    color: var(--text-muted);
  }

  .more {
    display: inline-block;
    margin-top: var(--space-6);
    padding-block: var(--space-3);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .screens {
    position: relative;
    display: block;
    padding-bottom: var(--space-7);
  }

  .desktop :global(img),
  .phone :global(img) {
    outline: 1px solid var(--rule);
    border-radius: var(--radius-screen);
  }

  .desktop {
    display: block;
    width: 88%;
  }

  .desktop :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 24%;
  }

  .phone :global(img) {
    aspect-ratio: 9 / 19.5;
    object-fit: cover;
    object-position: top;
    box-shadow: 0 0 0 0.5rem var(--bg);
  }

  @media (min-width: 1024px) {
    .row {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
      align-items: center;
    }
  }
</style>
