---
// The home page's opening: the headline, then a real client site building down the screen over its own code.
// Choosing a project in the list builds that one and lends the page its brand color (DESIGN.md → Signature).
import Img from "./Img.astro";
import { site } from "../data/site";
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const servicesText = (project: Project) =>
  project.services.map((s, i) => (i === 0 ? s : s.toLowerCase())).join(", ");
---

<section class="hero container" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="headline">
    {site.home.headline}
  </h1>

  <div class="grid">
    <div class="intro">
      <p class="lede">{site.home.lede}</p>
      <div class="actions">
        <a class="btn btn--primary" href={site.home.primaryAction.href}>
          {site.home.primaryAction.label}
        </a>
        <a class="btn btn--ghost" href={site.home.secondaryAction.href}>
          {site.home.secondaryAction.label}
        </a>
      </div>

      <div class="picker">
        <p class="hint muted" id="projects-hint">
          {site.home.projectsHint}
        </p>
        <ul aria-label={site.home.projectsLabel} aria-describedby="projects-hint">
          {projects.map((project, i) => (
            <li style={`--accent: ${project.accent}`}>
              <button
                type="button"
                data-project={project.id}
                data-accent={project.accent}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <span class="mono path">{project.id}</span>
                <span class="kind">
                  {project.kind}
                  {project.status === "in-progress" &&
                    `, ${site.projectLabels.inProgress.toLowerCase()}`}
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <figure class="stage-wrap">
      <div class="stage" data-stage>
        {projects.map((project, i) => (
          <div class="slide" data-slide={project.id} data-active={i === 0 ? "" : undefined}>
            <pre aria-hidden="true">{project.code}</pre>
            <div class="built">
              <Img
                src={project.screens.desktop.src}
                alt={project.screens.desktop.alt}
                sizes="(min-width: 1024px) 56vw, 100vw"
                priority={i === 0}
                loading="eager"
              />
            </div>
          </div>
        ))}
        <div class="line" aria-hidden="true"></div>
      </div>
      {projects.map((project, i) => (
        <figcaption data-caption={project.id} hidden={i !== 0}>
          <a href={`/work/${project.id}/`}>
            <strong>{project.name}</strong>, {project.kind.toLowerCase()} in{" "}
            {project.place.split(",")[0]}
          </a>
          <span class="muted">{servicesText(project)}</span>
        </figcaption>
      ))}
    </figure>
  </div>
</section>

<style>
  @property --hide {
    syntax: "<percentage>";
    inherits: true;
    initial-value: 0%;
  }

  .hero {
    padding-top: var(--space-6);
    padding-bottom: var(--space-9);
  }

  .headline {
    font-size: var(--text-display);
    line-height: 0.88;
  }

  .grid {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-8);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .picker {
    margin-top: var(--space-7);
  }

  .hint {
    font-size: var(--text-small);
    margin-bottom: var(--space-3);
  }

  .picker ul {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .picker button {
    all: unset;
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    min-height: 48px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
    color: var(--text-muted);
    cursor: pointer;
  }

  .picker button:hover,
  .picker button[aria-pressed="true"] {
    color: var(--text);
  }

  .picker button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* The active project's marker is a text cursor in that client's color */
  .path::before {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-right: 0.6em;
    vertical-align: -0.2em;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.2s;
  }

  [aria-pressed="true"] .path::before {
    opacity: 1;
  }

  .kind {
    font-size: var(--text-small);
  }

  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
    outline: 1px solid var(--rule);
    border-radius: var(--radius-screen);
  }

  .slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  .slide[data-active] {
    visibility: visible;
  }

  pre {
    position: absolute;
    inset: 0;
    padding: var(--space-5) var(--space-5);
    font: 0.8125rem/1.8 var(--font-mono);
    color: var(--code);
    white-space: pre;
    overflow: hidden;
  }

  /* With JavaScript and motion allowed, the page starts unbuilt and the script builds it */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stage {
      --hide: 100%;
    }
  }

  .built {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 var(--hide) 0);
  }

  .built :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .line {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - var(--hide));
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 1.75rem 0.2rem var(--accent);
    opacity: 0;
    transition: background-color var(--duration-accent);
  }

  .stage[data-building] .line {
    opacity: 1;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--text-small);
  }

  figcaption[hidden] {
    display: none;
  }

  figcaption a {
    color: var(--text-muted);
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  figcaption a:hover {
    text-decoration-color: var(--accent);
  }

  figcaption strong {
    color: var(--text);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  @media (max-width: 1023px) {
    .stage-wrap {
      order: -1;
    }

    pre {
      font-size: 0.6875rem;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>("[data-stage]")!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-project]")];
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  function show(id: string, accent: string) {
    for (const slide of stage.querySelectorAll<HTMLElement>("[data-slide]")) {
      slide.toggleAttribute("data-active", slide.dataset.slide === id);
    }
    for (const caption of document.querySelectorAll<HTMLElement>("[data-caption]")) {
      caption.hidden = caption.dataset.caption !== id;
    }
    for (const button of buttons)
      button.setAttribute("aria-pressed", String(button.dataset.project === id));
    // The page borrows the client's brand color while their project is on screen
    document.body.style.setProperty("--accent", accent);
    if (still) return;
    for (const running of stage.getAnimations()) running.cancel();
    stage.setAttribute("data-building", "");
    const build = stage.animate([{ "--hide": "100%" }, { "--hide": "0%" }], {
      duration: 2600,
      easing: "cubic-bezier(0.65, 0, 0.35, 1)",
      fill: "forwards",
    });
    build.onfinish = () => stage.removeAttribute("data-building");
  }

  for (const button of buttons) {
    button.addEventListener("click", () => show(button.dataset.project!, button.dataset.accent!));
  }

  // One build on arrival, of the first project; after that the visitor chooses
  const first = buttons[0];
  if (first) show(first.dataset.project!, first.dataset.accent!);
</script>
