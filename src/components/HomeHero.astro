---
// The home page's opening: what the owner gets, then the clients' real work as a collage. Each piece sits at its own
// depth and shifts with the pointer (fine pointers, motion allowed), inviting a closer look. Behind it, a soft glow in
// the featured clients' own brand colors: the work lights the page.
import AskBox from "./AskBox.astro";
import Img from "./Img.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";

// The clients whose work is in the collage lend their colors to the glow
const color = (id: string) =>
  projects.find((project) => project.id === id)?.accent ?? "transparent";
const glow = `--glow-1: ${color("fanzi-pet")}; --glow-2: ${color("shawarma-way")}; --glow-3: ${color("hair-by-christopher")}`;

const pieces = [
  { src: "fanzi-pet/site-home-desktop.jpg", alt: "The Fanzi Pet website", depth: 0.5, class: "a" },
  {
    src: "shawarma-way/site-home-desktop.jpg",
    alt: "The Shawarma Way website",
    depth: 0.8,
    class: "b",
  },
  {
    src: "fanzi-pet/vans-side-by-side.webp",
    alt: "Fanzi Pet’s two wrapped vans",
    depth: 1.1,
    class: "c",
  },
  {
    src: "hair-by-christopher/site-home-phone.jpg",
    alt: "Hair By Christopher’s website on a phone",
    depth: 1.4,
    class: "d",
  },
];
---

<section class="hero container" aria-labelledby="hero-heading">
  <div class="words">
    <h1 id="hero-heading">{site.home.headline}</h1>
    <p class="lede">{site.home.lede}</p>
    <AskBox />
    <p class="timing">
      {site.home.timing}{" "}
      <a class="link" href={`sms:${site.phoneSms}`}>
        {site.home.textAction}
      </a>
    </p>
  </div>
  <div class="collage" role="group" aria-label={site.home.collageLabel} data-collage>
    <div class="glow piece" style={glow} data-depth="-0.8" aria-hidden="true"></div>
    {pieces.map((piece) => (
      <div class:list={["piece", piece.class]} data-depth={piece.depth} data-pixels>
        <Img src={piece.src} alt={piece.alt} sizes="(min-width: 1024px) 34vw, 80vw" priority />
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-6) var(--space-8);
  }

  .lede {
    margin-top: var(--space-5);
  }

  .timing {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .collage {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1 / 0.86;
  }

  .piece {
    position: absolute;
    transform: translate(var(--x, 0), var(--y, 0));
    transition: transform 0.5s var(--ease-out);
  }

  /* The clients' colors as soft light behind the work; stronger in light so it reads on white */
  .glow {
    inset: -16% -10% -12% -8%;
    z-index: -1;
    opacity: 0.8;
    filter: blur(72px);
    background:
      radial-gradient(42% 46% at 30% 30%, var(--glow-1), transparent 70%),
      radial-gradient(36% 42% at 78% 55%, var(--glow-2), transparent 70%),
      radial-gradient(32% 36% at 38% 86%, var(--glow-3), transparent 70%);
    pointer-events: none;
  }

  :global([data-theme="dark"]) .glow {
    opacity: 0.45;
  }

  .piece {
    border-radius: var(--radius-screen);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .glow {
    overflow: visible;
    box-shadow: none;
  }

  .d {
    border-radius: 1rem;
  }

  .piece :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .a {
    width: 72%;
    aspect-ratio: 16 / 10;
    left: 0;
    top: 2%;
  }

  .b {
    width: 54%;
    aspect-ratio: 16 / 10;
    right: 0;
    top: 32%;
  }

  .c {
    width: 38%;
    aspect-ratio: 4 / 3;
    right: 8%;
    bottom: 0;
  }

  .c :global(img) {
    object-position: center;
  }

  .d {
    width: 21%;
    aspect-ratio: 9 / 19.5;
    left: 8%;
    bottom: 0;
  }

  .d :global(img) {
    border-radius: 1rem;
  }

  /* Wide screens: the text keeps the content column's left edge; the collage runs wider, toward the window's edge */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      max-width: none;
      padding-left: max(var(--gutter), calc((100vw - var(--content-max)) / 2 + var(--gutter)));
      padding-right: max(var(--gutter), calc((100vw - var(--content-max)) / 4));
    }
  }
</style>

<script>
  const collage = document.querySelector<HTMLElement>("[data-collage]");
  const moves = matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)").matches;
  if (collage && moves) {
    const pieces = [...collage.querySelectorAll<HTMLElement>("[data-depth]")];
    let frame = 0;
    addEventListener("pointermove", (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        // -1 to 1 across the window; each piece moves up to 14px times its depth
        const dx = (event.clientX / innerWidth - 0.5) * 2;
        const dy = (event.clientY / innerHeight - 0.5) * 2;
        for (const piece of pieces) {
          const depth = Number(piece.dataset.depth);
          piece.style.setProperty("--x", `${(dx * 10 * depth).toFixed(1)}px`);
          piece.style.setProperty("--y", `${(dy * 10 * depth).toFixed(1)}px`);
        }
      });
    });
    document.documentElement.addEventListener("pointerleave", () => {
      for (const piece of pieces) {
        piece.style.removeProperty("--x");
        piece.style.removeProperty("--y");
      }
    });
  }
</script>
