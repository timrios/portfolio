---
// A band of results. On the home page: the featured results from projects.ts (those with a `band` line), each naming
// the kind of business. On a project page: that project's results, with their source.
import { projects } from "../data/projects";
import { site } from "../data/site";

interface Props {
  /** A project's results; leave out for the home page's featured results */
  items?: { figure: string; text: string }[];
  /** Where the numbers come from (project pages) */
  source?: string;
  label?: string;
}

const featured = projects
  .flatMap((project) => project.results.items)
  .flatMap((item) => (item.band ? [{ figure: item.figure, ...item.band }] : []))
  .sort((a, b) => a.order - b.order);
const { items = featured, source, label = site.home.resultsLabel } = Astro.props;
---

<section
  class="on-deep deep results"
  aria-label={label}
  style={`--cols: ${items.length > 4 ? 3 : items.length}`}
>
  <ul class="container" role="list">
    {items.map((item) => (
      <li>
        <b>{item.figure}</b>
        <span>{item.text}</span>
      </li>
    ))}
  </ul>
  {source && <p class="container source">{source}</p>}
</section>

<style>
  .results {
    margin-top: var(--space-8);
    padding-block: var(--space-6);
  }

  ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5) var(--space-4);
    list-style: none;
  }

  /* Wide screens: one row for up to four results; more wrap in rows of three, so none is left alone */
  @media (min-width: 1024px) {
    .results {
      margin-top: 0;
      padding-block: var(--space-8);
    }

    ul {
      grid-template-columns: repeat(var(--cols), 1fr);
      gap: var(--space-6) var(--space-5);
    }
  }

  .source {
    margin-top: var(--space-5);
    color: var(--text-muted);
    font: 400 var(--text-mono) / 1.35 var(--font-mono);
  }

  b {
    display: block;
    color: var(--accent);
    font-size: var(--text-1);
    font-weight: 600;
    letter-spacing: -0.024em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  span {
    display: block;
    margin-top: var(--space-1);
    max-width: 16rem;
    color: var(--text-muted);
    font-size: var(--text-small);
    line-height: 1.3;
  }
</style>
