---
// A project page, ordered for a business owner: what the business is, the results, the before and after (with the
// phone view), then what I did section by section, the client's words, and the next project.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Img from "../../components/Img.astro";
import Closing from "../../components/Closing.astro";
import CompareSlider from "../../components/CompareSlider.astro";
import ProjectPreview from "../../components/ProjectPreview.astro";
import ResultsBand from "../../components/ResultsBand.astro";
import FeaturedReel from "../../components/FeaturedReel.astro";
import { projects, type Project } from "../../data/projects";
import { visibleQuotes } from "../../data/quotes";
import { reels } from "../../data/reels";
import { site } from "../../data/site";

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const labels = site.projectLabels;
// An archived site shows the original address it captured ("agsaflyers.com"), not web.archive.org
const shownUrl =
  project.status === "past"
    ? new URL(project.liveUrl.replace(/^.*?\/(https?:\/\/)/, "$1")).host.replace(/^www\./, "")
    : new URL(project.liveUrl).host.replace(/^www\./, "");
const siteLabel = { live: labels.liveSite, "in-progress": labels.preview, past: labels.archived }[
  project.status
];
const quote = visibleQuotes.find((q) => q.projectId === project.id);
const hasReels = reels.some((reel) => reel.projectId === project.id);
---

<BaseLayout
  title={project.pageTitle}
  description={project.pageDescription}
  image={project.screens.desktop.src}
>
  <header class="intro container" style={`--client: ${project.accent}`}>
    <p class="kind">
      <span class="marker" aria-hidden="true"></span>
      {project.kind}, {project.place}
      {project.status === "in-progress" && <span class="status">{labels.inProgress}</span>}
    </p>
    <h1 style={`view-transition-name: project-${project.id}`}>{project.name}</h1>
    <p class="lede">{project.summary}</p>
    <ul class="facts" role="list">
      <li>
        <span class="muted">{labels.whatIDid}:</span> {project.services.join(", ")}
      </li>
      <li>
        <span class="muted">{siteLabel}:</span>{" "}
        <a class="link tap" href={project.liveUrl}>
          {shownUrl}
        </a>
      </li>
      {project.links.map((link) => (
        <li>
          <span class="muted">{link.label}:</span>{" "}
          <a class="link tap" href={link.href}>
            {new URL(link.href).pathname.replaceAll("/", "") || link.label}
          </a>
        </li>
      ))}
    </ul>
    <button type="button" class="btn btn--primary browse" data-open-preview={project.id}>
      {site.preview.open}
    </button>
    <ProjectPreview project={project} />
  </header>

  <ResultsBand
    items={project.results.items}
    source={project.results.source}
    label={project.results.heading}
  />

  <section class="container section" aria-labelledby="before-heading">
    <div class="before-text">
      <h2 id="before-heading">{project.before.heading}</h2>
      <p class="body">{project.before.text}</p>
    </div>
    <div class="compare">
      <CompareSlider project={project} sizes="(min-width: 1024px) 60vw, 100vw" />
      <figure class="phone">
        <Img
          src={project.screens.phone.src}
          alt={project.screens.phone.alt}
          sizes="(min-width: 1024px) 16vw, 40vw"
        />
        <figcaption>{labels.phoneView}</figcaption>
      </figure>
    </div>
  </section>

  {project.sections.map((section, s) => (
    <section class="container section block" aria-labelledby={`section-${s}`}>
      <p class="service">{section.service}</p>
      <h2 id={`section-${s}`}>{section.heading}</h2>
      <p class="body">{section.text}</p>
      {section.points.length > 0 && (
        <ul class="points" role="list">
          {section.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      )}
      {section.service === "Social media" && hasReels && <FeaturedReel projectId={project.id} />}
      {section.images.length > 0 && (
        <div class="gallery">
          {section.images.map((image) => (
            <figure class:list={["figure", image.treatment, { wide: image.wide }]}>
              <Img src={image.src} alt={image.alt} sizes="(min-width: 1024px) 38vw, 100vw" />
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </section>
  ))}

  {quote && (
    <section class="container section" aria-label={`${quote.name}, ${quote.role}`}>
      <figure class="quote">
        {!quote.approved && <p class="draft">{site.home.draftLabel}</p>}
        <blockquote>
          <p>“{quote.text}”</p>
        </blockquote>
        <figcaption>
          <strong>{quote.name}</strong> <span class="muted">{quote.role}</span>
        </figcaption>
      </figure>
    </section>
  )}

  {next.id !== project.id && (
    <nav class="container section next" aria-label={labels.next} style={`--client: ${next.accent}`}>
      <a href={`/work/${next.id}/`}>
        <span class="next-text">
          <span class="muted">{labels.next}</span>
          <span class="next-name">
            <span class="marker" aria-hidden="true" />
            {next.name}
          </span>
          <span class="muted">{next.outcome}</span>
        </span>
        <Img src={next.screens.desktop.src} alt="" sizes="(min-width: 1024px) 40vw, 100vw" />
      </a>
    </nav>
  )}

  <Closing />
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-7) var(--space-8);
  }

  .kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  .marker {
    display: inline-block;
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
    background: var(--client);
    box-shadow: 0 0 0 1px var(--field-border);
  }

  .next .marker {
    flex: none;
    width: 0.4em;
    height: 0.4em;
  }

  .status {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--band);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  h1 {
    width: fit-content;
    margin-top: var(--space-3);
  }

  .intro .lede {
    margin-top: var(--space-4);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .browse {
    margin-top: var(--space-5);
  }

  .before-text {
    max-width: var(--content-narrow);
  }

  .compare {
    display: grid;
    gap: var(--space-6);
    align-items: end;
    margin-top: var(--space-7);
  }

  .phone {
    max-width: 14rem;
  }

  .phone :global(img) {
    width: 100%;
    aspect-ratio: 9 / 19.5;
    object-fit: cover;
    object-position: top;
    border-radius: 1.25rem;
    box-shadow: var(--shadow);
  }

  .phone figcaption,
  .figure figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .block {
    border-top: 1px solid var(--rule);
  }

  .service {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--band);
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .body {
    margin-top: var(--space-4);
    max-width: var(--content-narrow);
    font-size: var(--text-lede);
  }

  .points {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
    max-width: var(--content-narrow);
  }

  /* Each point gets a small accent dot: these are things done, set apart from the paragraph above */
  .points li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--text-muted);
  }

  .points li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.55em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .gallery {
    display: grid;
    gap: var(--space-6) var(--space-5);
    margin-top: var(--space-7);
  }

  .figure :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-screen);
    box-shadow: var(--shadow);
  }

  .gallery .wide {
    grid-column: 1 / -1;
  }

  .gallery .wide :global(img) {
    aspect-ratio: auto;
  }

  /* Logos are shown whole on the background they were designed for: Christopher's on ink, light-ground art on paper */
  .gallery .artwork :global(img),
  .gallery .artwork-on-light :global(img) {
    object-fit: contain;
    padding: var(--space-6);
    background: var(--color-ink);
  }

  .gallery .artwork-on-light :global(img) {
    background: var(--color-paper);
  }

  .quote {
    max-width: 48rem;
    padding: var(--space-7);
    border-radius: var(--radius-card);
    background: var(--band);
  }

  .quote blockquote p {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .quote figcaption {
    margin-top: var(--space-5);
  }

  .draft {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px dashed var(--error);
    border-radius: var(--radius-pill);
    color: var(--error);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .next a {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition:
      box-shadow 0.25s,
      transform 0.25s var(--ease);
  }

  .next a:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .next-text {
    display: grid;
    gap: var(--space-2);
  }

  .next-name {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-2);
    font-weight: 650;
    letter-spacing: -0.022em;
    line-height: 1.1;
  }

  .next :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border-radius: var(--radius-screen);
  }

  @media (min-width: 768px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .compare {
      grid-template-columns: 1fr 12rem;
    }

    .next a {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      padding: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next a:hover {
      transform: none;
    }
  }
</style>
