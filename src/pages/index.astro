---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import ResultsBand from "../components/ResultsBand.astro";
import WorkGrid from "../components/WorkGrid.astro";
import Quotes from "../components/Quotes.astro";
import FeaturedReel from "../components/FeaturedReel.astro";
import ServiceList from "../components/ServiceList.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Closing from "../components/Closing.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`${site.name}: websites and brands for San Antonio businesses`}
  fullTitle
  description={site.description}
  image="social/home.jpg"
>
  <HomeHero />
  <ResultsBand />

  <section id="work" class="container section" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">{site.home.workHeading}</h2>
      <p class="lede">{site.home.workIntro}</p>
    </div>
    <WorkGrid />
  </section>

  <Quotes />
  <FeaturedReel />

  <ServiceList />

  <section id="how-it-works" class="container section" aria-labelledby="process-heading">
    <div class="section-head">
      <h2 id="process-heading">{site.home.processHeading}</h2>
      <p class="lede">{site.home.processIntro}</p>
    </div>
    <ProcessSteps />
  </section>

  <Closing />
</BaseLayout>

<style>
  .section-head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  @media (min-width: 1024px) {
    .section-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
</style>
