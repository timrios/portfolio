---
import BaseLayout from "../layouts/BaseLayout.astro";
import BuildHero from "../components/BuildHero.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ServiceList from "../components/ServiceList.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Closing from "../components/Closing.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
---

<BaseLayout
  title={`${site.name}: websites and brands for local businesses`}
  fullTitle
  description={site.description}
  image="social/home.jpg"
  accent={projects[0]?.accent}
>
  <BuildHero projects={projects} />

  <section id="work" class="container section" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">{site.home.workHeading}</h2>
      <p class="lede">{site.home.workIntro}</p>
    </div>
    {projects.map((project, i) => (
      <ProjectRow project={project} eager={i === 0} />
    ))}
  </section>

  <section class="container section" aria-labelledby="services-heading">
    <div class="section-head">
      <h2 id="services-heading">{site.home.servicesHeading}</h2>
    </div>
    <ServiceList />
  </section>

  <section id="how-it-works" class="container section" aria-labelledby="process-heading">
    <div class="section-head">
      <h2 id="process-heading">{site.home.processHeading}</h2>
      <p class="lede">{site.home.processIntro}</p>
    </div>
    <ProcessSteps />
  </section>

  <Closing />
</BaseLayout>

<style>
  .section-head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .section-head h2 {
    max-width: 16ch;
  }

  @media (min-width: 1024px) {
    .section-head {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }
</style>
