---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const n = site.notFound;
---

<BaseLayout title={n.title} description={n.text} image="social/home.jpg" noindex>
  <section class="container lost">
    <p class="mono muted">404</p>
    <h1>
      {n.heading}
      <span class="caret" aria-hidden="true"></span>
    </h1>
    <p class="lede">{n.text}</p>
    <a class="btn btn--primary" href="/">
      {n.action}
    </a>
  </section>
</BaseLayout>

<style>
  .lost {
    padding-block: var(--space-9) var(--section);
  }

  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-display);
    max-width: 12ch;
  }

  /* The editor cursor, waiting for something to be written */
  .caret {
    display: inline-block;
    width: 0.42em;
    height: 0.75em;
    margin-left: 0.08em;
    background: var(--accent);
    /* Four blinks, then it rests: nothing on the site blinks for more than five seconds */
    animation: blink 1.1s steps(1) 4;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .lede {
    margin-top: var(--space-5);
  }

  .btn {
    margin-top: var(--space-6);
  }
</style>
