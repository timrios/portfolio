---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const n = site.notFound;
---

<BaseLayout title={n.title} description={n.text} image="social/home.jpg" noindex>
  <section class="container lost">
    <p class="mono muted">404</p>
    <h1>{n.heading}</h1>
    <p class="lede">{n.text}</p>
    <a class="btn btn--primary" href="/">
      {n.action}
    </a>
  </section>
</BaseLayout>

<style>
  .lost {
    padding-block: var(--space-9) var(--section);
  }

  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-display);
    max-width: 12ch;
  }

  .lede {
    margin-top: var(--space-5);
  }

  .btn {
    margin-top: var(--space-6);
  }
</style>
