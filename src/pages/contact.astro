---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const c = site.contact;
const f = c.fields;
const errorText = c.error.replace("{email}", site.email);
---

<BaseLayout title={c.title} description={c.description} image="social/home.jpg">
  <div class="contact container">
    <div class="intro">
      <h1>{c.heading}</h1>
      <p class="lede">{c.intro}</p>
      <a class="text-me" href={`sms:${site.phoneSms}`}>
        <span class="muted">{c.textPrompt}</span>
        <strong>{site.phone}</strong>
      </a>
      <p class="reply">{c.replyTime}</p>
    </div>

    <form
      action={site.formEndpoint}
      method="POST"
      data-contact-form
      data-sending={c.sending}
      data-success={c.success}
      data-error={errorText}
      data-reach-missing={c.errors.reach}
    >
      <input type="hidden" name="_subject" value={`New enquiry from ${site.domain}`} />
      <!-- Spam trap: people never see or fill this field -->
      <label class="trap" aria-hidden="true">
        Leave this empty
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>

      <div class="row">
        <div class="field-wrap">
          <label class="field">
            <span class="label">
              {f.name}{" "}
              <span class="note" aria-hidden="true">
                {c.required}
              </span>
            </span>
            <input
              type="text"
              name="name"
              autocomplete="name"
              autocapitalize="words"
              enterkeyhint="next"
              required
              aria-required="true"
              aria-describedby="error-name"
              data-check="name"
              data-invalid={c.errors.name}
            />
          </label>
          <p class="field-error" id="error-name"></p>
        </div>
        <label class="field">
          <span class="label">
            {f.business} <span class="note">{c.optional}</span>
          </span>
          <input
            type="text"
            name="business"
            autocomplete="organization"
            autocapitalize="words"
            enterkeyhint="next"
          />
        </label>
      </div>

      <!-- Either one is enough to reply; the script asks for one if both are empty -->
      <fieldset aria-describedby="error-reach">
        <legend>
          {f.reachLegend} <span class="note">{f.reachNote}</span>
        </legend>
        <div class="row">
          <div class="field-wrap">
            <label class="field">
              <span class="label">{f.email}</span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                spellcheck="false"
                enterkeyhint="next"
                aria-describedby="error-email"
                data-check="email"
                data-invalid={c.errors.email}
              />
            </label>
            <p class="field-error" id="error-email"></p>
          </div>
          <div class="field-wrap">
            <label class="field">
              <span class="label">{f.phone}</span>
              <input
                type="tel"
                name="phone"
                autocomplete="tel"
                enterkeyhint="next"
                aria-describedby="error-phone"
                data-check="phone"
                data-invalid={c.errors.phone}
              />
            </label>
            <p class="field-error" id="error-phone"></p>
          </div>
        </div>
        <p class="field-error" id="error-reach"></p>
      </fieldset>

      <fieldset>
        <legend>{c.needsLegend}</legend>
        <div class="needs">
          {c.needs.map((need) => (
            <label class="check">
              <input type="checkbox" name="needs" value={need} />
              <span>{need}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field-wrap">
        <label class="field">
          <span class="label">
            {f.message}{" "}
            <span class="note" aria-hidden="true">
              {c.required}
            </span>
          </span>
          <textarea
            name="message"
            rows="5"
            required
            aria-required="true"
            aria-describedby="error-message"
            data-check="message"
            data-invalid={c.errors.message}
            placeholder={c.messagePlaceholder}
          ></textarea>
        </label>
        <p class="field-error" id="error-message"></p>
      </div>

      <button class="btn btn--primary" type="submit">
        {c.submitLabel}
      </button>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>

    <div class="after">
      <h2 class="next-heading">{c.nextHeading}</h2>
      <ol class="next">
        {c.next.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="direct muted">
        {c.emailPrompt}{" "}
        <a class="link tap" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* On phones the form comes straight after the text option; what happens next follows it */
  .contact {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--section);
  }

  h1 {
    max-width: 12ch;
  }

  /* Texting is the quickest way for most owners: offered before the form, as a large tap target */
  .text-me {
    display: inline-grid;
    gap: var(--space-1);
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--band);
    text-decoration: none;
  }

  .text-me strong {
    font-size: var(--text-3);
    font-weight: 650;
    color: var(--accent);
  }

  .text-me:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .reply {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .intro .lede {
    margin-top: var(--space-5);
  }

  .next-heading {
    font-size: var(--text-3);
    font-weight: 700;
    letter-spacing: 0;
  }

  .next {
    counter-reset: step;
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
    max-width: var(--content-narrow);
  }

  .next li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding-block: var(--space-3);
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .next li::before {
    content: counter(step);
    font-family: var(--font-mono);
    color: var(--text);
  }

  .direct {
    margin-top: var(--space-6);
  }

  .direct a {
    color: var(--text);
  }

  form {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .row {
    display: grid;
    gap: var(--space-3);
  }

  .muted {
    color: var(--text-muted);
  }

  /* The label is the box, with its name tucked inside the top: a phone shows more of the form
     at once, and a tap anywhere in the box focuses the field (DESIGN.md → Contact form fields) */
  .field {
    display: grid;
    align-content: center;
    min-height: calc(var(--target) + var(--space-3));
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--field-border);
    border-radius: var(--radius-screen);
    cursor: text;
  }

  .field:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 0;
    border-color: transparent;
  }

  .field-wrap {
    display: grid;
    gap: var(--space-1);
  }

  /* Errors are words under the box, not only a red edge, so color never carries them alone */
  .field-error {
    font-size: var(--text-small);
    color: var(--error);
  }

  .field-error:empty {
    display: none;
  }

  fieldset > .field-error {
    margin-top: var(--space-2);
  }

  .field:has([aria-invalid="true"]) {
    border-color: var(--error);
  }

  .label {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--text-muted);
  }

  .note {
    font-weight: 400;
    color: var(--text-muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0;
    font: 400 var(--text-body) / 1.5 var(--font-body);
    color: var(--text);
    background: transparent;
    border: 0;
    border-radius: 0;
    /* The box shows focus for the whole field */
    outline: none;
  }

  /* Safari and Chrome paint autofilled fields their own color; keep the box one surface */
  .field input:-webkit-autofill {
    -webkit-text-fill-color: var(--text);
    box-shadow: 0 0 0 100vmax var(--surface) inset;
    caret-color: var(--text);
  }

  textarea {
    resize: vertical;
  }

  textarea::placeholder {
    color: var(--text-muted);
  }

  /* A group gets more room than a single box, so it reads as its own step */
  fieldset {
    margin: var(--space-3) 0;
    border: 0;
    padding: 0;
  }

  legend {
    margin-bottom: var(--space-3);
    padding: 0;
    font-size: var(--text-small);
    font-weight: 600;
  }

  .btn {
    margin-top: var(--space-3);
  }

  .needs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .check {
    position: relative;
    display: inline-flex;
    font-size: var(--text-small);
    font-weight: 400;
  }

  .check input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .check span {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--field-border);
    border-radius: var(--radius-screen);
    color: var(--text-muted);
  }

  /* Ticked: filled, plus a check mark, so the state never rests on color alone */
  .check input:checked + span {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .check input:checked + span::before {
    content: "✓";
    margin-right: var(--space-2);
  }

  .check input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .status:empty {
    display: none;
  }

  .status[data-state="error"] {
    color: var(--error);
  }

  /* Formspree's documented way to hide its spam trap; bots still find and fill it */
  .trap {
    display: none;
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }

    .btn {
      justify-self: start;
    }
  }

  @media (min-width: 1024px) {
    /* Intro beside the form, then "What happens next" as its own row across the page:
       the steps no longer hang below the shorter form (DESIGN.md → Contact page) */
    .contact {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-9);
      align-items: start;
    }

    .after {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 5fr 7fr;
      /* The second row takes the steps' extra height, so "Or email" stays under its heading */
      grid-template-rows: auto 1fr;
      gap: var(--space-3) var(--space-9);
      align-items: start;
    }

    .direct {
      margin-top: 0;
    }

    .next {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0;
      max-width: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .next li {
      grid-template-columns: none;
      align-content: start;
      gap: var(--space-2);
      padding-block: var(--space-4) 0;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]")!;
  const status = form.querySelector<HTMLElement>("[data-status]")!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

  // A problem typed into the home page's question arrives here, already written in the message
  const need = new URLSearchParams(location.search).get("need");
  const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  if (need && message) message.value = need;

  // The script checks everything itself and writes errors under each field: the browser's own
  // bubbles vanish after a moment on iPhones and let "name@site" through
  form.noValidate = true;

  type Field = HTMLInputElement | HTMLTextAreaElement;
  const field = (name: string) => form.querySelector<Field>(`[data-check="${name}"]`)!;
  const fields = ["name", "email", "phone", "message"].map(field);
  const [, email, phone] = fields as [Field, Field, Field, Field];
  const reachError = form.querySelector<HTMLElement>("#error-reach")!;

  // Needs a dot and an ending after the @, which the browser's own check doesn't ask for
  const emailOk = (v: string) => /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)*\.[a-z]{2,}$/i.test(v);

  // US numbers need the area code: 10 digits, or 11 starting with 1. A number starting with +
  // is international and may have 8 to 15 digits
  const phoneOk = (v: string) => {
    if (!/^\+?[\d\s().-]+$/.test(v)) return false;
    const digits = v.replace(/\D/g, "");
    if (v.startsWith("+")) return digits.length >= 8 && digits.length <= 15;
    return digits.length === 10 || (digits.length === 11 && digits.startsWith("1"));
  };

  const isValid = (f: Field) => {
    const v = f.value.trim();
    if (f === email) return !v || emailOk(v);
    if (f === phone) return !v || phoneOk(v);
    return v !== "";
  };

  const show = (f: Field, ok: boolean) => {
    f.setAttribute("aria-invalid", String(!ok));
    form.querySelector(`#error-${f.dataset.check}`)!.textContent = ok ? "" : f.dataset.invalid!;
  };

  // Start every field at "not invalid": Safari and Firefox otherwise read an empty required
  // field to screen readers as invalid before the visitor has typed anything
  fields.forEach((f) => f.setAttribute("aria-invalid", "false"));

  const reachOk = () => Boolean(email.value.trim() || phone.value.trim());
  const showReach = (ok: boolean) => {
    reachError.textContent = ok ? "" : form.dataset.reachMissing!;
    if (!ok) [email, phone].forEach((f) => f.setAttribute("aria-invalid", "true"));
  };

  fields.forEach((f) => {
    // Check a typed email or phone when the visitor moves on, not while they're typing it
    f.addEventListener("blur", () => {
      if (f.value.trim() && (f === email || f === phone)) show(f, isValid(f));
    });
    // Once an error shows, it clears as soon as the field is fixed
    f.addEventListener("input", () => {
      if (f.getAttribute("aria-invalid") === "true" && isValid(f)) show(f, true);
      if (reachError.textContent && reachOk()) {
        showReach(true);
        [email, phone].forEach((g) => show(g, isValid(g)));
      }
    });
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const results = fields.map((f) => {
      const ok = isValid(f);
      show(f, ok);
      return ok;
    });
    const reached = reachOk();
    showReach(reached);
    const firstBad = !reached && results[0] ? email : fields[results.indexOf(false)];
    if (firstBad) {
      firstBad.focus();
      return;
    }
    button.disabled = true;
    status.textContent = form.dataset.sending!;
    status.dataset.state = "";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      status.textContent = form.dataset.success!;
      status.dataset.state = "success";
    } catch {
      status.textContent = form.dataset.error!;
      status.dataset.state = "error";
    } finally {
      button.disabled = false;
    }
  });
</script>
