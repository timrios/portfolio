---
import BaseLayout from "../layouts/BaseLayout.astro";
import Closing from "../components/Closing.astro";
import Img from "../components/Img.astro";
import LogoRow from "../components/LogoRow.astro";
import { about } from "../data/about";
---

<BaseLayout title={about.title} description={about.description} image="social/home.jpg">
  <header class="intro container">
    <h1>{about.heading}</h1>
    <figure class="portrait">
      <Img
        src={about.portrait.src}
        alt={about.portrait.alt}
        sizes="(min-width: 1024px) 20rem, (min-width: 768px) 40vw, 13rem"
        priority
      />
    </figure>
    <div class="text">
      {about.intro.map((paragraph, i) => (
        <p class:list={{ lede: i === 0 }}>{paragraph}</p>
      ))}
    </div>
  </header>

  <div class="container">
    <LogoRow heading={about.logosHeading} />
  </div>

  <section class="container section block" aria-labelledby="background-heading">
    <div>
      <h2 id="background-heading">{about.backgroundHeading}</h2>
      <a class="resume-link link tap" href="/resume/">
        {about.resumeLink}
      </a>
    </div>
    <ol class="timeline" role="list">
      {about.background.map((item) => (
        <li>
          <p class="when">{item.when}</p>
          <div>
            <h3>{item.what}</h3>
            <p>{item.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="container section block" aria-labelledby="principles-heading">
    <h2 id="principles-heading">{about.principlesHeading}</h2>
    <ul class="principles" role="list">
      {about.principles.map((principle) => (
        <li>
          <h3>{principle.name}</h3>
          <p>{principle.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <Closing />
</BaseLayout>

<style>
  .resume-link {
    display: inline-block;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
  }

  .intro {
    display: grid;
    grid-template-areas:
      "heading"
      "portrait"
      "text";
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  h1 {
    grid-area: heading;
    max-width: 16ch;
  }

  /* The portrait keeps its own pale ground, like a framed print on the page, so the green jacket never
     melts into the dark look (a cut-out would). The frame uses the card shape and shadow from the system. */
  .portrait {
    grid-area: portrait;
    width: min(100%, 13rem);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow);
    outline: 1px solid var(--rule);
    outline-offset: -1px;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
  }

  .text {
    grid-area: text;
    max-width: var(--content-narrow);
  }

  .text p + p {
    margin-top: var(--space-4);
  }

  .text .lede {
    color: var(--text);
  }

  .text p:not(.lede) {
    color: var(--text-muted);
  }

  .block {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-9);
    border-top: 1px solid var(--rule);
  }

  .timeline,
  .principles {
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .when {
    font-weight: 600;
    color: var(--accent);
  }

  .timeline h3,
  .principles h3 {
    font-size: var(--text-3);
  }

  .timeline p,
  .principles p {
    margin-top: var(--space-2);
    color: var(--text-muted);
    max-width: var(--content-narrow);
  }

  .timeline .when {
    margin-top: 0.35rem;
  }

  .principles li {
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .principles {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
      grid-template-areas:
        "heading portrait"
        "text portrait";
      align-items: start;
      column-gap: var(--space-8);
    }

    .portrait {
      width: 100%;
    }

    .timeline li {
      grid-template-columns: 9rem 1fr;
    }

    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .block {
      grid-template-columns: 3fr 9fr;
      gap: var(--space-8);
    }
  }
</style>
