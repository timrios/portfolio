# Copy to .env and fill in. Never commit real values.
# List every variable the site uses here, with no values.

# Launch switch: set to true in the Cloudflare build settings when timrios.dev points at the Worker.
# Until then robots.txt blocks all crawlers so the workers.dev preview isn't indexed.
SITE_INDEXABLE=

# Phone number for the resume PDF only (npm run resume-pdf). Never shown on the public site.
RESUME_PHONE=
